{% liquid
  assign contact_information_direction = section.settings.direction | default: 'horizontal'
  unless contact_information_direction == 'horizontal' or contact_information_direction == 'vertical'
    assign contact_information_direction = 'horizontal'
  endunless
  assign contact_information_items_per_row = section.settings.items_per_row | default: 4 | plus: 0
  if contact_information_items_per_row < 1 or contact_information_items_per_row > 4
    assign contact_information_items_per_row = 4
  endif
  if contact_information_direction == 'vertical'
    assign contact_information_items_per_row = 1
  endif

  assign contact_information_width = 'page-width'
  if section.settings.section_width == 'full_width'
    assign contact_information_width = 'full-width'
  endif
  assign contact_information_scheme = section.settings.color_scheme | default: 'scheme-1'
  if section.settings.color_scheme.id != blank
    assign contact_information_scheme = section.settings.color_scheme.id
  endif
  assign contact_information_scheme = contact_information_scheme | default: 'scheme-1' | handleize
  assign contact_information_gap = section.settings.gap | default: 0 | plus: 0
  assign contact_information_padding_top = section.settings.padding_top | default: 0 | plus: 0
  assign contact_information_padding_bottom = section.settings.padding_bottom | default: 0 | plus: 0
  assign contact_information_padding_top_mobile = section.settings.padding_top_mobile | default: 0 | plus: 0
  assign contact_information_padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 0 | plus: 0
%}

{% capture contact_information_style %}
  --contact-information-columns: {{ contact_information_items_per_row }};
  {% if section.settings.background_color != blank %}--contact-information-background-color: {{ section.settings.background_color | escape }};{% endif %}
  --contact-information-gap: {{ contact_information_gap }}px;
  --contact-information-padding-top: {{ contact_information_padding_top }}px;
  --contact-information-padding-bottom: {{ contact_information_padding_bottom }}px;
  {% if section.settings.customize_mobile_padding %}
    --contact-information-padding-top-mobile: {{ contact_information_padding_top_mobile }}px;
    --contact-information-padding-bottom-mobile: {{ contact_information_padding_bottom_mobile }}px;
  {% endif %}
{% endcapture %}

<div class="contact-information contact-information--{{ contact_information_width }} contact-information--{{ contact_information_direction }}">
  <div class="section-spacing contact-information__spacing color-scheme section-color-scope {{ contact_information_scheme }}" style="{{ contact_information_style | strip }}">
    {% if section.settings.background_image != blank %}
      <div class="contact-information__background" aria-hidden="true">
        {{ section.settings.background_image | image_url: width: 2000 | image_tag }}
      </div>
    {% endif %}
    <div class="container {{ contact_information_width }} contact-information__container">
      <div class="contact-information__grid">
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .contact-information {
    width: 100%;
  }

  .contact-information__spacing {
    position: relative;
    overflow: hidden;
    width: 100%;
    padding-top: var(--contact-information-padding-top, 0px);
    padding-bottom: var(--contact-information-padding-bottom, 0px);
    background-color: var(--contact-information-background-color, var(--background-color));
  }

  .contact-information__container {
    position: relative;
    z-index: 1;
  }

  .contact-information__background {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .contact-information__background img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .contact-information__grid {
    display: grid;
    grid-template-columns: repeat(var(--contact-information-columns, 4), minmax(0, 1fr));
    align-items: stretch;
    gap: var(--contact-information-gap, 0px);
  }

  .contact-information__grid > .group {
    min-width: 0;
    min-height: 170px;
  }

  @media (max-width: 767.98px) {
    .contact-information__spacing {
      padding-top: var(--contact-information-padding-top-mobile, var(--contact-information-padding-top, 0px));
      padding-bottom: var(--contact-information-padding-bottom-mobile, var(--contact-information-padding-bottom, 0px));
    }

    .contact-information__grid {
      grid-template-columns: 1fr;
    }

    .contact-information__grid > .group {
      min-height: 150px;
    }

  }
{% endstylesheet %}

