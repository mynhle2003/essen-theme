{% liquid
  assign blog_posts_container_width = 'page-width'
  if section.settings.section_width == 'full_width'
    assign blog_posts_container_width = 'full-width'
  endif

  assign blog_posts_scheme = section.settings.color_scheme | default: 'scheme-1'
  if section.settings.color_scheme.id != blank
    assign blog_posts_scheme = section.settings.color_scheme.id
  endif
  assign blog_posts_scheme = blog_posts_scheme | default: 'scheme-1' | handleize

  assign blog_posts_desktop_alignment = section.settings.desktop_alignment | default: 'left'
  unless blog_posts_desktop_alignment == 'left' or blog_posts_desktop_alignment == 'center' or blog_posts_desktop_alignment == 'right'
    assign blog_posts_desktop_alignment = 'left'
  endunless

  assign blog_posts_mobile_alignment = section.settings.mobile_alignment | default: 'left'
  unless blog_posts_mobile_alignment == 'left' or blog_posts_mobile_alignment == 'center' or blog_posts_mobile_alignment == 'right'
    assign blog_posts_mobile_alignment = 'left'
  endunless

  assign blog_posts_gap_desktop = section.settings.gap_desktop | default: 32 | plus: 0
  if blog_posts_gap_desktop < 0 or blog_posts_gap_desktop > 100
    assign blog_posts_gap_desktop = 32
  endif
  assign blog_posts_gap_mobile = section.settings.gap_mobile | default: 24 | plus: 0
  if blog_posts_gap_mobile < 0 or blog_posts_gap_mobile > 100
    assign blog_posts_gap_mobile = 24
  endif

  assign blog_posts_list_block = section.blocks | where: 'type', 'blog-list' | first
  assign blog_posts_source = blank
  if blog_posts_list_block != blank
    assign blog_posts_source = blog_posts_list_block.settings.blog
  endif

  assign blog_posts_padding_top = section.settings.padding_top | default: 0 | plus: 0
  assign blog_posts_padding_bottom = section.settings.padding_bottom | default: 0 | plus: 0
  assign blog_posts_padding_top_mobile = section.settings.padding_top_mobile | default: 0 | plus: 0
  assign blog_posts_padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 0 | plus: 0
%}

{% capture blog_posts_style %}
  {% if blog_posts_gap_desktop != 32 %}--blog-posts-gap-desktop: {{ blog_posts_gap_desktop }}px;{% endif %}
  {% if blog_posts_gap_mobile != 24 %}--blog-posts-gap-mobile: {{ blog_posts_gap_mobile }}px;{% endif %}
  {% if blog_posts_padding_top != 0 %}--blog-posts-padding-top: {{ blog_posts_padding_top }}px;{% endif %}
  {% if blog_posts_padding_bottom != 0 %}--blog-posts-padding-bottom: {{ blog_posts_padding_bottom }}px;{% endif %}
  {% if section.settings.customize_mobile_padding %}
    {% if blog_posts_padding_top_mobile != blog_posts_padding_top %}--blog-posts-padding-top-mobile: {{ blog_posts_padding_top_mobile }}px;{% endif %}
    {% if blog_posts_padding_bottom_mobile != blog_posts_padding_bottom %}--blog-posts-padding-bottom-mobile: {{ blog_posts_padding_bottom_mobile }}px;{% endif %}
  {% endif %}
{% endcapture %}
{% assign blog_posts_style = blog_posts_style | strip %}

<div
  class="section-spacing blog-posts section-color-scope {{ blog_posts_scheme }}"
  {% if blog_posts_style != blank %}style="{{ blog_posts_style }}"{% endif %}
>
  <div
    class="container {{ blog_posts_container_width }} blog-posts__container"
    data-blog-posts
    data-desktop-alignment="{{ blog_posts_desktop_alignment }}"
    data-mobile-alignment="{{ blog_posts_mobile_alignment }}"
  >
    <div class="blog-posts__header">
      {% content_for 'block', type: 'header', id: 'header' %}
    </div>
    <div class="blog-posts__actions">
      {% content_for 'block', type: 'collection-tabs-view-all', id: 'blog-posts-view-all', closest.collection: blog_posts_source %}
    </div>
    <div class="blog-posts__list">
      {% content_for 'block', type: 'blog-list', id: 'blog-list', closest.blog: blog_posts_source %}
    </div>
  </div>
</div>

{% stylesheet %}
  .blog-posts {
    width: 100%;
    padding-top: var(--blog-posts-padding-top, 0px);
    padding-bottom: var(--blog-posts-padding-bottom, 0px);
  }

  .blog-posts__container {
    display: flex;
    flex-direction: column;
    gap: var(--blog-posts-gap-desktop, 32px);
    min-width: 0;
  }

  .blog-posts__header,
  .blog-posts__actions,
  .blog-posts__list {
    min-width: 0;
  }

  .blog-posts__header {
    display: flex;
    align-items: flex-start;
  }

  .blog-posts__header > .block-header {
    min-width: 0;
  }

  .blog-posts__actions {
    display: flex;
    align-items: center;
  }

  .blog-posts__list > .blog-list > .blog-list__navigation--top {
    margin-block-end: var(--blog-posts-gap-desktop, 32px);
  }

  @media (min-width: 768px) {
    .blog-posts__container[data-desktop-alignment='left'],
    .blog-posts__container[data-desktop-alignment='right'] {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto auto;
      grid-template-areas:
        'header actions navigation'
        'posts posts posts';
      column-gap: var(--blog-posts-gap-desktop, 32px);
      row-gap: var(--blog-posts-gap-desktop, 32px);
    }

    .blog-posts__container[data-desktop-alignment='right'] {
      grid-template-columns: auto auto minmax(0, 1fr);
      grid-template-areas:
        'navigation actions header'
        'posts posts posts';
    }

    .blog-posts__container[data-desktop-alignment='center'] {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'header'
        'navigation'
        'posts'
        'actions';
      row-gap: var(--blog-posts-gap-desktop, 32px);
    }

    .blog-posts__header { grid-area: header; }
    .blog-posts__actions { grid-area: actions; }
    .blog-posts__list { display: contents; }
    .blog-posts__list > .blog-list { display: contents; }
    .blog-posts__list > .blog-list > .blog-list__carousel { grid-area: posts; }
    .blog-posts__list > .blog-list > .blog-list__navigation--top {
      grid-area: navigation;
      align-self: end;
      margin-block-end: 0;
    }

    .blog-posts__container[data-desktop-alignment='left'] .blog-posts__header {
      justify-content: flex-start;
    }

    .blog-posts__container[data-desktop-alignment='center'] .blog-posts__header {
      align-items: center;
      justify-content: center;
    }

    .blog-posts__container[data-desktop-alignment='right'] .blog-posts__header {
      justify-content: flex-end;
    }

    .blog-posts__container[data-desktop-alignment='left'] .blog-posts__header > .block-header {
      --flex-align: start;
      --text-align-default: left;
    }

    .blog-posts__container[data-desktop-alignment='center'] .blog-posts__header > .block-header {
      --flex-align: center;
      --text-align-default: center;
    }

    .blog-posts__container[data-desktop-alignment='right'] .blog-posts__header > .block-header {
      --flex-align: end;
      --text-align-default: right;
    }

    .blog-posts__container[data-desktop-alignment='left'] .blog-posts__actions,
    .blog-posts__container[data-desktop-alignment='right'] .blog-posts__actions {
      align-self: end;
    }

    .blog-posts__container[data-desktop-alignment='center'] .blog-posts__actions,
    .blog-posts__container[data-desktop-alignment='center'] .blog-list__navigation--top {
      justify-content: center;
      justify-self: center;
    }
  }

  @media (max-width: 767.98px) {
    .blog-posts__container {
      gap: var(--blog-posts-gap-mobile, var(--blog-posts-gap-desktop, 32px));
    }

    .blog-posts__list > .blog-list > .blog-list__navigation--top {
      margin-block-end: var(--blog-posts-gap-mobile, var(--blog-posts-gap-desktop, 32px));
    }

    .blog-posts__container[data-mobile-alignment='left'] .blog-posts__header {
      align-items: flex-start;
    }

    .blog-posts__container[data-mobile-alignment='center'] .blog-posts__header {
      align-items: center;
    }

    .blog-posts__container[data-mobile-alignment='right'] .blog-posts__header {
      align-items: flex-end;
    }

    .blog-posts__container[data-mobile-alignment='left'] .blog-posts__header > .block-header {
      --flex-align-mobile: start;
      --text-align-default: left;
    }

    .blog-posts__container[data-mobile-alignment='center'] .blog-posts__header > .block-header {
      --flex-align-mobile: center;
      --text-align-default: center;
    }

    .blog-posts__container[data-mobile-alignment='right'] .blog-posts__header > .block-header {
      --flex-align-mobile: end;
      --text-align-default: right;
    }

    .blog-posts__container[data-mobile-alignment='left'] .blog-posts__actions,
    .blog-posts__container[data-mobile-alignment='left'] .blog-list__navigation--top {
      justify-content: flex-start;
    }

    .blog-posts__container[data-mobile-alignment='center'] .blog-posts__actions,
    .blog-posts__container[data-mobile-alignment='center'] .blog-list__navigation--top {
      justify-content: center;
    }

    .blog-posts__container[data-mobile-alignment='right'] .blog-posts__actions,
    .blog-posts__container[data-mobile-alignment='right'] .blog-list__navigation--top {
      justify-content: flex-end;
    }

    .blog-posts {
      padding-top: var(--blog-posts-padding-top-mobile, var(--blog-posts-padding-top, 0px));
      padding-bottom: var(--blog-posts-padding-bottom-mobile, var(--blog-posts-padding-bottom, 0px));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Blog posts",
  "class": "section-blog-posts",
  "disabled_on": {
    "templates": ["article", "blog"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:labels.section_width",
      "options": [
        { "value": "page_width", "label": "t:options.section_width.page_width" },
        { "value": "full_width", "label": "t:options.section_width.full_width" }
      ],
      "default": "page_width"
    },
    {
      "type": "select",
      "id": "desktop_alignment",
      "label": "t:labels.desktop_alignment",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" },
        { "value": "right", "label": "t:options.alignment.right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "mobile_alignment",
      "label": "t:labels.mobile_alignment",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" },
        { "value": "right", "label": "t:options.alignment.right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:general.gap"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "t:options.device.desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "t:options.device.mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "t:general.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:general.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:options.position.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:options.position.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_padding",
      "label": "t:labels.customize_mobile_padding",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:labels.mobile_top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:labels.mobile_bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.customize_mobile_padding }}"
    }
  ],
  "presets": [
    {
      "name": "Blog posts",
      "category": "Blog",
      "settings": {
        "section_width": "page_width",
        "desktop_alignment": "left",
        "mobile_alignment": "left",
        "gap_desktop": 32,
        "gap_mobile": 24,
        "color_scheme": "scheme-1",
        "padding_top": 50,
        "padding_bottom": 50,
        "customize_mobile_padding": false
      },
      "blocks": [
        {
          "type": "header",
          "id": "header",
          "static": true,
          "settings": {
            "width": "fit",
            "gap_desktop": 12,
            "gap_mobile": 8
          },
          "blocks": [
            {
              "type": "heading",
              "settings": {
                "text": "<p>Blog posts</p>",
                "heading_size": "lg",
                "html_tag": "h2"
              }
            }
          ]
        },
        {
          "type": "collection-tabs-view-all",
          "id": "blog-posts-view-all",
          "static": true,
          "settings": {
            "button_label": "View all",
            "button_style": "tertiary",
            "show_icon": false,
            "icon": "arrow",
            "icon_position": "after",
            "icon_size": "inherit",
            "icon_width": 20,
            "width": "fit",
            "width_mobile": "fit",
            "customize_mobile_padding": false
          }
        },
        {
          "type": "blog-list",
          "id": "blog-list",
          "static": true,
          "settings": {
            "blog": "",
            "max_posts": 4,
            "layout_type": "carousel",
            "columns_desktop": "4",
            "columns_mobile": "1",
            "show_next_slide_preview_on_desktop": false,
            "gap_desktop": 4,
            "gap_mobile": 4,
            "show_navigation_on_desktop": true,
            "navigation_position": "top",
            "navigation_style": "secondary",
            "navigation_icon": "chevron",
            "navigation_behavior": "show_on_hover",
            "show_pagination_on_desktop": true,
            "pagination_type": "progress_bar",
            "pagination_padding_desktop": 50,
            "pagination_padding_mobile": 24,
            "pagination_limit_width": true,
            "pagination_max_width": 260,
            "autoplay": false,
            "autoplay_pause_on_hover": true,
            "autoplay_speed": 4
          },
          "blocks": [
            {
              "type": "blog-card",
              "id": "blog-card",
              "static": true,
              "settings": {
                "ratio": "original",
                "alignment": "left",
                "desktop_gap": 8,
                "mobile_gap": 8,
                "border_thickness": 0,
                "corner_radius": "inherit",
                "shadow": "none",
                "color_type": "inherit",
                "color_scheme": "scheme-1",
                "padding_top": 12,
                "padding_bottom": 0,
                "padding_left": 0,
                "padding_right": 0,
                "customize_mobile_padding": false
              },
              "blocks": [
                {
                  "type": "blog-card-title",
                  "settings": {
                    "line_limit": "no_limit",
                    "heading_size": "sm",
                    "html_tag": "h3",
                    "padding_top": 8,
                    "padding_bottom": 0,
                    "customize_mobile_padding": false
                  }
                },
                {
                  "type": "blog-card-meta",
                  "settings": {
                    "show_date": true,
                    "show_author": true,
                    "size": "sm",
                    "text_color": "",
                    "padding_top": 0,
                    "padding_bottom": 4,
                    "customize_mobile_padding": false
                  }
                },
                {
                  "type": "blog-card-description",
                  "settings": {
                    "text_limit": "two",
                    "size": "md",
                    "padding_top": 0,
                    "padding_bottom": 6,
                    "customize_mobile_padding": false
                  }
                },
                {
                  "type": "blog-card-button",
                  "settings": {
                    "style": "tertiary",
                    "show_icon": false,
                    "padding_top": 0,
                    "padding_bottom": 0,
                    "customize_mobile_padding": false
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
