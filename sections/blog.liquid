{% comment %}
  Blog posts section for the Blogs template only. The current blog resource
  supplies the article source; this section is not a merchant-selected blog
  list for other templates.
{% endcomment %}

{% assign blog_source = blog %}

<div
  class="blog-posts blog-posts--blog-template section-color-scope {{ section.settings.color_scheme | default: 'scheme-1' }}"
  data-section-id="{{ section.id }}"
  data-template="blog"
  data-posts-per-page="{{ section.settings.posts_per_page }}"
  style="
    --blog-posts-padding-top: {{ section.settings.padding_top }}px;
    --blog-posts-padding-bottom: {{ section.settings.padding_bottom }}px;
    --blog-posts-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --blog-posts-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --blog-posts-align: {{ section.settings.alignment }};
  "
>
  <div class="blog-posts__container{% if section.settings.width == 'full' %} blog-posts__container--full{% endif %}">
    {% if blog_source != blank %}
      {% paginate blog_source.articles by section.settings.posts_per_page %}
        {% content_for 'block', type: 'heading', id: 'heading' %}
        {% content_for 'block', type: 'blog-archive-list', id: 'blog-archive-list' %}
      {% endpaginate %}
    {% elsif request.design_mode %}
      <div class="blog-posts__empty" {{ section.shopify_attributes }}>
        Select a blog in the section settings to display blog posts.
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .blog-posts {
    padding-top: var(--blog-posts-padding-top);
    padding-bottom: var(--blog-posts-padding-bottom);
    text-align: var(--blog-posts-align);
  }

  .blog-posts__container {
    width: min(calc(100% - 32px), var(--page-width));
    max-width: var(--page-width);
    margin-inline: auto;
  }

  .blog-posts__container--full {
    width: 100%;
  }

  .blog-posts__empty {
    padding: 2rem;
    border: 1px dashed currentColor;
    text-align: center;
  }

  @media (max-width: 767.98px) {
    .blog-posts__container { width: 100%; padding-inline: 16px; }
    .blog-posts {
      padding-top: var(--blog-posts-padding-top-mobile);
      padding-bottom: var(--blog-posts-padding-bottom-mobile);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Blog posts",
  "class": "section-blog-posts-blog",
  "enabled_on": {
    "templates": ["blog"]
  },
  "blocks": [
    { "type": "heading" },
    { "type": "blog-archive-list" }
  ],
  "max_blocks": 2,
  "settings": [
    {
      "type": "range",
      "id": "posts_per_page",
      "label": "Posts per page",
      "min": 1,
      "max": 24,
      "step": 1,
      "default": 7
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        { "value": "page", "label": "Page" },
        { "value": "full", "label": "Full" }
      ],
      "default": "page"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 50
    }
  ],
  "presets": [
    {
      "name": "Blog posts",
      "category": "Blog",
      "blocks": [
        {
          "type": "heading",
          "id": "heading",
          "static": true,
          "settings": {
            "text": "<p>News</p>",
            "html_tag": "h1"
          }
        },
        {
          "type": "blog-archive-list",
          "id": "blog-archive-list",
          "static": true,
          "blocks": [
            {
              "type": "featured-post"
            },
            {
              "type": "blog-card",
              "id": "blog-card",
              "static": true,
              "blocks": [
                {
                  "type": "blog-card-title",
                  "settings": {
                    "line_limit": "no_limit",
                    "heading_size": "sm",
                    "html_tag": "h3",
                    "padding_top": 8,
                    "padding_bottom": 0,
                    "customize_mobile_padding": false
                  }
                },
                {
                  "type": "blog-card-meta",
                  "settings": {
                    "show_date": true,
                    "show_author": true,
                    "size": "sm",
                    "text_color": "",
                    "padding_top": 0,
                    "padding_bottom": 4,
                    "customize_mobile_padding": false
                  }
                },
                {
                  "type": "blog-card-description",
                  "settings": {
                    "text_limit": "two",
                    "size": "md",
                    "padding_top": 0,
                    "padding_bottom": 6,
                    "customize_mobile_padding": false
                  }
                },
                {
                  "type": "blog-card-button",
                  "settings": {
                    "style": "tertiary",
                    "show_icon": false,
                    "padding_top": 0,
                    "padding_bottom": 0,
                    "customize_mobile_padding": false
                  }
                }
              ]
            },
            {
              "type": "pagination"
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
