{% liquid
  assign section_width = 'page-width'
  if section.settings.section_width == 'full_width'
    assign section_width = 'full-width'
  endif
  assign layout = section.settings.layout | default: 'carousel'
  assign carousel_id = 'CollectionThumbnails-' | append: section.id
  assign previous_label = 'collection_list.previous' | t
  assign next_label = 'collection_list.next' | t
  assign justify = 'flex-start'
  if section.settings.alignment == 'center'
    assign justify = 'center'
  elsif section.settings.alignment == 'right'
    assign justify = 'flex-end'
  endif
%}
{% if layout == 'carousel' %}
  {% render 'swiper-stylesheet' %}
  <script type="module" src="{{ 'collection-thumbnails.js' | asset_url }}"></script>
{% endif %}
<div class="section-spacing collection-thumbnails color-scheme section-color-scope {{ section.settings.color_scheme | default: 'scheme-1' }}" style="--ct-gap:{{ section.settings.gap_desktop | default: 40 }}px;--ct-gap-mobile:{{ section.settings.gap_mobile | default: 20 }}px;--ct-card-gap:{{ section.settings.card_gap | default: 10 }}px;--ct-image-width:{{ section.settings.image_width_desktop | default: 110 }}px;--ct-image-width-mobile:{{ section.settings.image_width_mobile | default: 85 }}px;--ct-justify:{{ justify }};--ct-padding-top:{{ section.settings.padding_top | default: 50 }}px;--ct-padding-bottom:{{ section.settings.padding_bottom | default: 50 }}px;{% if section.settings.background_color != blank %}--background-color:{{ section.settings.background_color }};{% endif %}{% if section.settings.customize_mobile_padding %}--ct-padding-top-mobile:{{ section.settings.padding_top_mobile }}px;--ct-padding-bottom-mobile:{{ section.settings.padding_bottom_mobile }}px;{% endif %}">
  {% if section.settings.background_media != 'none' %}<div class="collection-thumbnails__background" aria-hidden="true">{% if section.settings.background_media == 'image' and section.settings.background_image != blank %}{{ section.settings.background_image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', alt: '' }}{% elsif section.settings.background_media == 'video' and section.settings.background_video != blank %}{{ section.settings.background_video | video_tag: autoplay: true, loop: true, muted: true, controls: false }}{% endif %}</div>{% endif %}
  <div class="container {{ section_width }} collection-thumbnails__container">
    {% capture items %}{% content_for 'blocks' %}{% endcapture %}
    {% if layout == 'carousel' %}
      <div class="collection-thumbnails__carousel-wrap" data-collection-thumbnails>
        {% capture attrs %}data-collection-thumbnails-carousel data-layout="carousel" data-swiper-gap-desktop="{{ section.settings.gap_desktop }}" data-swiper-gap-mobile="{{ section.settings.gap_mobile }}" data-swiper-previous-selector="[data-ct-prev]" data-swiper-next-selector="[data-ct-next]"{% endcapture %}
        {% render 'swiper-carousel', id: carousel_id, content: items, root_class: 'collection-thumbnails__carousel', root_attributes: attrs, aria_label: 'Collection thumbnails' %}
        {% render 'swiper-navigation', style: section.settings.navigation_style, icon: section.settings.navigation_icon, behavior: section.settings.navigation_behavior, wrapper_class: 'collection-thumbnails__navigation', previous_attribute: 'data-ct-prev', next_attribute: 'data-ct-next', previous_label: previous_label, next_label: next_label %}
      </div>
    {% else %}<div class="collection-thumbnails__grid">{{ items }}</div>{% endif %}
  </div>
</div>
{% stylesheet %}
.collection-thumbnails{position:relative;isolation:isolate;overflow:hidden;padding-top:var(--ct-padding-top);padding-bottom:var(--ct-padding-bottom);background:var(--background-color)}.collection-thumbnails__background{position:absolute;z-index:-1;inset:0}.collection-thumbnails__background :is(img,video){display:block;width:100%;height:100%;object-fit:cover}.collection-thumbnails__carousel-wrap{position:relative;min-width:0}.collection-thumbnails__carousel .swiper-slide{width:auto}.collection-thumbnails__carousel.is-static .swiper-wrapper{justify-content:var(--ct-justify);gap:var(--ct-gap)}.collection-thumbnails__carousel.is-static~.collection-thumbnails__navigation{display:none}.collection-thumbnails__grid{display:flex;flex-wrap:wrap;justify-content:var(--ct-justify);gap:var(--ct-gap)}.collection-thumbnails__navigation{opacity:0;transition:opacity var(--motion-duration-standard) var(--motion-ease-standard)}.collection-thumbnails__carousel-wrap:hover .collection-thumbnails__navigation,.collection-thumbnails__carousel-wrap:focus-within .collection-thumbnails__navigation,.swiper-carousel__navigation--always{opacity:1}.collection-thumbnails__navigation:has(.swiper-button-lock){display:none}@media (min-width:768px) and (max-width:1149.98px){.collection-thumbnails{padding-top:calc(var(--ct-padding-top)*.75);padding-bottom:calc(var(--ct-padding-bottom)*.75)}}@media (max-width:767.98px){.collection-thumbnails{padding-top:var(--ct-padding-top-mobile,calc(var(--ct-padding-top)*.5));padding-bottom:var(--ct-padding-bottom-mobile,calc(var(--ct-padding-bottom)*.5))}.collection-thumbnails__carousel.is-static .swiper-wrapper{gap:var(--ct-gap-mobile)}.collection-thumbnails__grid{gap:var(--ct-gap-mobile)}}
{% endstylesheet %}
