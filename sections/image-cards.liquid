      "default": "horizontal"
    },
    {
      "type": "checkbox",
      "id": "vertical_on_mobile",
      "label": "t:labels.vertical_on_mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "t:general.gap"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "t:options.device.desktop",
      "min": 0,
      "max": 100,
      "step": 1,
