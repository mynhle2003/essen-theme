{% liquid
  assign faq_scheme = section.settings.color_scheme | default: 'scheme-1'
  if section.settings.color_scheme.id != blank
    assign faq_scheme = section.settings.color_scheme.id
  endif
  assign faq_scheme = faq_scheme | default: 'scheme-1' | handleize

  assign faq_width = 'page-width'
  if section.settings.section_width == 'full_width'
    assign faq_width = 'full-width'
  endif

  assign faq_alignment = 'start'
  case section.settings.alignment
    when 'center'
      assign faq_alignment = 'center'
    when 'right'
      assign faq_alignment = 'end'
  endcase

  assign faq_category_gap_desktop = section.settings.gap_desktop | default: 8 | plus: 0
  assign faq_category_gap_mobile = section.settings.gap_mobile | default: 8 | plus: 0
  assign faq_padding_top = section.settings.padding_top | default: 0 | plus: 0
  assign faq_padding_bottom = section.settings.padding_bottom | default: 0 | plus: 0
  assign faq_padding_top_mobile = section.settings.padding_top_mobile | default: faq_padding_top | plus: 0
  assign faq_padding_bottom_mobile = section.settings.padding_bottom_mobile | default: faq_padding_bottom | plus: 0
%}

{% capture faq_style %}
  --faq-header-align: {{ faq_alignment }};
  --faq-header-text-align: {{ section.settings.alignment | default: 'left' }};
  --faq-padding-top: {{ faq_padding_top }}px;
  --faq-padding-bottom: {{ faq_padding_bottom }}px;
  {% if section.settings.customize_mobile_padding %}
    --faq-padding-top-mobile: {{ faq_padding_top_mobile }}px;
    --faq-padding-bottom-mobile: {{ faq_padding_bottom_mobile }}px;
  {% endif %}
{% endcapture %}

{% capture faq_categories_style %}
  {% render 'layout-flow-style',
    direction: 'column',
    wrap: 'nowrap',
    align_items: 'stretch',
    gap: faq_category_gap_desktop,
    gap_mobile: faq_category_gap_mobile
  %}
{% endcapture %}
{% assign faq_categories_style = faq_categories_style | strip %}

<div class="section-spacing faq-section color-scheme section-color-scope {{ faq_scheme }}" style="{{ faq_style | strip }}">
  <div class="container {{ faq_width }} faq-section__container">
    {% if section.settings.title != blank or section.settings.description != blank %}
      <header class="faq-section__header">
        {% if section.settings.title != blank %}
          <h2 class="heading-text heading-lg faq-section__title">{{ section.settings.title | escape }}</h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <div class="body-text body-md faq-section__description rte">{{ section.settings.description }}</div>
        {% endif %}
      </header>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="faq-section__categories layout-flow layout-flow--responsive" style="{{ faq_categories_style }}">
        {% content_for 'blocks' %}
      </div>
    {% elsif request.design_mode %}
      <div class="faq-section__empty">Add FAQ categories to get started.</div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .faq-section {
    width: 100%;
    padding-top: var(--faq-padding-top, 0px);
    padding-bottom: var(--faq-padding-bottom, 0px);
  }

  .faq-section__container {
    max-width: 900px;
  }

  .faq-section__header {
    display: grid;
    gap: 12px;
    justify-items: var(--faq-header-align, start);
    margin-bottom: 2.5rem;
    text-align: var(--faq-header-text-align, left);
  }

  .faq-section__title,
  .faq-section__description {
    margin: 0;
  }

  .faq-section__description {
    max-width: 42rem;
  }

  .faq-section__description > :first-child {
    margin-top: 0;
  }

  .faq-section__description > :last-child {
    margin-bottom: 0;
  }

  .faq-section__categories {
    min-width: 0;
  }

  .faq-section__empty {
    padding: 1rem;
    border: 1px dashed var(--border-color);
    color: var(--body-color);
  }

  @media (max-width: 767.98px) {
    .faq-section {
      padding-top: var(--faq-padding-top-mobile, var(--faq-padding-top, 0px));
      padding-bottom: var(--faq-padding-bottom-mobile, var(--faq-padding-bottom, 0px));
    }

    .faq-section__header {
      gap: 12px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.faq",
  "class": "section-faq",
  "enabled_on": { "templates": ["*"] },
  "blocks": [
    { "type": "faq_category" },
    { "type": "faq_item" }
  ],
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:labels.title",
      "default": "Frequently asked questions"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:labels.description"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:labels.alignment",
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:general.spacing"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "t:labels.desktop_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "t:labels.mobile_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:labels.section_width",
      "options": [
        { "value": "page_width", "label": "t:options.section_width.page_width" },
        { "value": "full_width", "label": "t:options.section_width.full_width" }
      ],
      "default": "page_width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:general.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_padding",
      "label": "t:labels.customize_mobile_padding",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:labels.mobile_top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:labels.mobile_bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.customize_mobile_padding }}"
    }
  ],
  "presets": [
    {
      "name": "t:general.faq",
      "category": "t:general.content",
      "blocks": [
        {
          "type": "faq_category",
          "settings": { "title": "Shipping" },
          "blocks": [
            { "type": "faq_item" },
            { "type": "faq_item" }
          ]
        },
        {
          "type": "faq_category",
          "settings": { "title": "Order process" },
          "blocks": [
            { "type": "faq_item" },
            { "type": "faq_item" },
            { "type": "faq_item" },
            { "type": "faq_item" }
          ]
        },
        {
          "type": "faq_category",
          "settings": { "title": "Delivery" },
          "blocks": [
            { "type": "faq_item" },
            { "type": "faq_item" },
            { "type": "faq_item" }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
