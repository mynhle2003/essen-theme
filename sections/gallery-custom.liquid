{% liquid
  assign gallery_custom_section_width = section.settings.section_width | default: 'full_width_no_padding'
  unless gallery_custom_section_width == 'page_width' or gallery_custom_section_width == 'full_width' or gallery_custom_section_width == 'full_width_no_padding'
    assign gallery_custom_section_width = 'full_width_no_padding'
  endunless

  assign gallery_custom_container_width = 'page-width'
  assign gallery_custom_container_no_padding = false

  case gallery_custom_section_width
    when 'full_width'
      assign gallery_custom_container_width = 'full-width'
    when 'full_width_no_padding'
      assign gallery_custom_container_width = 'full-width'
      assign gallery_custom_container_no_padding = true
  endcase

  assign gallery_custom_direction = section.settings.direction | default: 'horizontal'
  unless gallery_custom_direction == 'horizontal' or gallery_custom_direction == 'vertical'
    assign gallery_custom_direction = 'horizontal'
  endunless

  assign gallery_custom_position = section.settings.position | default: 'center'
  unless gallery_custom_position == 'top' or gallery_custom_position == 'center' or gallery_custom_position == 'bottom'
    assign gallery_custom_position = 'center'
  endunless

  assign gallery_custom_horizontal_alignment = section.settings.horizontal_alignment | default: 'space-between'
  unless gallery_custom_horizontal_alignment == 'left' or gallery_custom_horizontal_alignment == 'center' or gallery_custom_horizontal_alignment == 'right' or gallery_custom_horizontal_alignment == 'space-between'
    assign gallery_custom_horizontal_alignment = 'space-between'
  endunless

  assign gallery_custom_alignment = section.settings.alignment | default: 'left'
  unless gallery_custom_alignment == 'left' or gallery_custom_alignment == 'center' or gallery_custom_alignment == 'right'
    assign gallery_custom_alignment = 'left'
  endunless

  assign gallery_custom_alignment_mobile = section.settings.alignment_mobile | default: 'left'
  unless gallery_custom_alignment_mobile == 'left' or gallery_custom_alignment_mobile == 'center' or gallery_custom_alignment_mobile == 'right'
    assign gallery_custom_alignment_mobile = 'left'
  endunless

  assign gallery_custom_flow_position = 'top'
  if gallery_custom_direction == 'horizontal'
    assign gallery_custom_flow_position = gallery_custom_position
  endif

  assign gallery_custom_flow_wrap = 'nowrap'

  assign gallery_custom_flow_alignment = 'start'
  case gallery_custom_alignment
    when 'center'
      assign gallery_custom_flow_alignment = 'center'
    when 'right'
      assign gallery_custom_flow_alignment = 'end'
  endcase

  assign gallery_custom_flow_horizontal_alignment = 'flex-start'
  case gallery_custom_horizontal_alignment
    when 'left'
      assign gallery_custom_flow_horizontal_alignment = 'flex-start'
    when 'center'
      assign gallery_custom_flow_horizontal_alignment = 'center'
    when 'right'
      assign gallery_custom_flow_horizontal_alignment = 'flex-end'
    when 'space-between'
      assign gallery_custom_flow_horizontal_alignment = 'space-between'
  endcase

  assign gallery_custom_flow_mobile_alignment = 'start'
  case gallery_custom_alignment_mobile
    when 'center'
      assign gallery_custom_flow_mobile_alignment = 'center'
    when 'right'
      assign gallery_custom_flow_mobile_alignment = 'end'
  endcase

  assign gallery_custom_flow_mobile_justify = 'flex-start'
  case gallery_custom_alignment_mobile
    when 'center'
      assign gallery_custom_flow_mobile_justify = 'center'
    when 'right'
      assign gallery_custom_flow_mobile_justify = 'flex-end'
  endcase

  assign gallery_custom_mobile_vertical = false
  if gallery_custom_direction == 'horizontal' and section.settings.customize_mobile_alignment
    assign gallery_custom_mobile_vertical = true
  endif

  assign gallery_custom_gap_desktop = section.settings.gap_desktop | default: 36 | plus: 0
  if gallery_custom_gap_desktop < 0 or gallery_custom_gap_desktop > 100
    assign gallery_custom_gap_desktop = 36
  endif
  assign gallery_custom_gap_mobile = section.settings.gap_mobile | default: 36 | plus: 0
  if gallery_custom_gap_mobile < 0 or gallery_custom_gap_mobile > 100
    assign gallery_custom_gap_mobile = 36
  endif

  assign gallery_custom_scheme = section.settings.color_scheme | default: 'scheme-3'
  if section.settings.color_scheme.id != blank
    assign gallery_custom_scheme = section.settings.color_scheme.id
  endif
  assign gallery_custom_scheme = gallery_custom_scheme | default: 'scheme-3' | handleize

  assign gallery_custom_padding_top = section.settings.padding_top | default: 16 | plus: 0
  assign gallery_custom_padding_bottom = section.settings.padding_bottom | default: 16 | plus: 0
  assign gallery_custom_padding_top_mobile = section.settings.padding_top_mobile | default: gallery_custom_padding_top | plus: 0
  assign gallery_custom_padding_bottom_mobile = section.settings.padding_bottom_mobile | default: gallery_custom_padding_bottom | plus: 0

  assign gallery_custom_content_class = 'gallery-custom__content layout-flow layout-flow--responsive gallery-custom__content--direction-' | append: gallery_custom_direction
%}

{% capture gallery_custom_style %}
  {% if gallery_custom_padding_top != 0 %}--section-padding-top: {{ gallery_custom_padding_top }}px;{% endif %}
  {% if gallery_custom_padding_bottom != 0 %}--section-padding-bottom: {{ gallery_custom_padding_bottom }}px;{% endif %}
  {% if section.settings.customize_mobile_padding %}
    {% if gallery_custom_padding_top_mobile != gallery_custom_padding_top %}--section-padding-top-mobile: {{ gallery_custom_padding_top_mobile }}px;{% endif %}
    {% if gallery_custom_padding_bottom_mobile != gallery_custom_padding_bottom %}--section-padding-bottom-mobile: {{ gallery_custom_padding_bottom_mobile }}px;{% endif %}
  {% endif %}
{% endcapture %}
{% assign gallery_custom_style = gallery_custom_style | strip | replace: '\n', ' ' %}

{% capture gallery_custom_content_style %}
  {% render 'layout-flow-group-style',
    direction: gallery_custom_direction,
    wrap: gallery_custom_flow_wrap,
    position: gallery_custom_flow_position,
    alignment: gallery_custom_flow_alignment,
    horizontal_alignment: gallery_custom_flow_horizontal_alignment,
    mobile_vertical: gallery_custom_mobile_vertical,
    mobile_alignment: gallery_custom_flow_mobile_alignment,
    mobile_justify: gallery_custom_flow_mobile_justify,
    gap: gallery_custom_gap_desktop,
    gap_mobile: gallery_custom_gap_mobile
  %}
{% endcapture %}
{% assign gallery_custom_content_style = gallery_custom_content_style | strip %}

{% if section.blocks.size > 0 or request.design_mode %}
  <div class="gallery-custom">
    <div
      class="section-spacing gallery-custom__spacing color-scheme section-color-scope {{ gallery_custom_scheme }}{% if gallery_custom_container_no_padding %} gallery-custom__spacing--no-padding{% endif %}"
      {% if gallery_custom_style != blank %}style="{{ gallery_custom_style }}"{% endif %}
    >
      <div class="container {{ gallery_custom_container_width }} gallery-custom__container{% if gallery_custom_container_no_padding %} gallery-custom__container--no-padding{% endif %}">
        <div
          class="{{ gallery_custom_content_class }}"
          {% if gallery_custom_content_style != blank %}style="{{ gallery_custom_content_style }}"{% endif %}
        >
          {% content_for 'blocks' %}
        </div>
      </div>
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .gallery-custom {
    width: 100%;
    min-width: 0;
  }

  .gallery-custom__spacing {
    width: 100%;
    min-width: 0;
  }

  .gallery-custom__container,
  .gallery-custom__content,
  .gallery-custom__content > * {
    min-width: 0;
  }

  .gallery-custom__container {
    position: relative;
  }

  .gallery-custom__spacing--no-padding {
    padding-inline: 0;
  }

  .gallery-custom__spacing .container.gallery-custom__container--no-padding {
    padding-inline: 0;
  }

  .gallery-custom__content--direction-horizontal > * {
    max-width: 100%;
  }
{% endstylesheet %}

