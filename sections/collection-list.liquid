{% liquid
  assign collection_list_container_width = 'page-width'
  if section.settings.section_width == 'full_width'
    assign collection_list_container_width = 'full-width'
  endif

  assign collection_list_desktop_alignment = section.settings.desktop_alignment | default: 'left'
  assign collection_list_desktop_justify = 'start'
  if collection_list_desktop_alignment == 'center'
    assign collection_list_desktop_justify = 'center'
  endif

  assign collection_list_mobile_alignment = section.settings.mobile_alignment | default: 'left'
  assign collection_list_mobile_justify = 'start'
  if collection_list_mobile_alignment == 'center'
    assign collection_list_mobile_justify = 'center'
  elsif collection_list_mobile_alignment == 'right'
    assign collection_list_mobile_justify = 'end'
  endif

  assign collection_list_scheme = section.settings.color_scheme | default: 'scheme-1'
  if section.settings.color_scheme.id != blank
    assign collection_list_scheme = section.settings.color_scheme.id
  endif
  assign collection_list_scheme = collection_list_scheme | default: 'scheme-1' | handleize

  assign collection_list_gap_desktop = section.settings.gap_desktop | default: 40 | plus: 0
  assign collection_list_gap_mobile = section.settings.gap_mobile | default: 30 | plus: 0
  assign collection_list_padding_top = section.settings.padding_top | default: 50 | plus: 0
  assign collection_list_padding_bottom = section.settings.padding_bottom | default: 50 | plus: 0
  assign collection_list_padding_top_mobile = section.settings.padding_top_mobile | default: collection_list_padding_top | plus: 0
  assign collection_list_padding_bottom_mobile = section.settings.padding_bottom_mobile | default: collection_list_padding_bottom | plus: 0
%}

{% capture collection_list_style %}
  {% if collection_list_mobile_justify != collection_list_desktop_justify %}--collection-list-justify-mobile: {{ collection_list_mobile_justify }};{% endif %}
  {% if collection_list_gap_desktop != 40 %}--collection-list-gap: {{ collection_list_gap_desktop }}px;{% endif %}
  {% if collection_list_gap_mobile != 30 %}--collection-list-gap-mobile: {{ collection_list_gap_mobile }}px;{% endif %}
  {% if collection_list_padding_top != 50 %}--collection-list-padding-top: {{ collection_list_padding_top }}px;{% endif %}
  {% if collection_list_padding_bottom != 50 %}--collection-list-padding-bottom: {{ collection_list_padding_bottom }}px;{% endif %}
  {% if section.settings.customize_mobile_padding %}
    {% if collection_list_padding_top_mobile != collection_list_padding_top %}--collection-list-padding-top-mobile: {{ collection_list_padding_top_mobile }}px;{% endif %}
    {% if collection_list_padding_bottom_mobile != collection_list_padding_bottom %}--collection-list-padding-bottom-mobile: {{ collection_list_padding_bottom_mobile }}px;{% endif %}
  {% endif %}
{% endcapture %}
{% assign collection_list_style = collection_list_style | strip %}

<div class="collection-list">
  <div
    class="section-spacing collection-list__spacing color-scheme section-color-scope {{ collection_list_scheme }}"
    {% if collection_list_style != blank %}style="{{ collection_list_style }}"{% endif %}
  >
    {% if section.settings.background_media != 'none' %}
      <div class="collection-list__background" aria-hidden="true">
        {% if section.settings.background_media == 'image' and section.settings.background_image != blank %}
          {{ section.settings.background_image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', alt: '' }}
        {% elsif section.settings.background_media == 'video' and section.settings.background_video != blank %}
          {{ section.settings.background_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: '2400x' }}
        {% else %}
          <div class="collection-list__background-placeholder placeholder-image">
            {{ 'collection-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div
      class="container {{ collection_list_container_width }} collection-list__container"
      data-desktop-alignment="{{ collection_list_desktop_alignment }}"
      data-mobile-alignment="{{ collection_list_mobile_alignment }}"
    >
      <div class="collection-list__header">
        {% content_for 'block', type: 'header', id: 'header' %}
      </div>
      <div class="collection-list__actions">
        {% content_for 'block', type: 'view-all-button', id: 'view-all' %}
      </div>
      <div class="collection-list__content">
        {% content_for 'block', type: 'collection-list-items', id: 'collection-list' %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .collection-list,
  .collection-list__spacing {
    width: 100%;
    min-width: 0;
  }

  .collection-list__spacing {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-top: var(--collection-list-padding-top, 50px);
    padding-bottom: var(--collection-list-padding-bottom, 50px);
    background-color: var(--background-color);
  }

  .collection-list__background {
    position: absolute;
    z-index: -1;
    inset: 0;
  }

  .collection-list__background img,
  .collection-list__background video,
  .collection-list__background-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collection-list__container {
    position: relative;
  }

  .collection-list__header,
  .collection-list__actions,
  .collection-list__content {
    min-width: 0;
  }

  .collection-list__header {
    display: flex;
    align-items: flex-start;
  }

  .collection-list__header > .block-header {
    min-width: 0;
  }

  .collection-list__actions {
    display: flex;
    align-items: center;
    max-width: 100%;
  }

  .collection-list__content > .collection-card-list > .collection-card-list__navigation--top {
    margin-block-end: var(--collection-list-gap, 40px);
  }

  @media (min-width: 768px) {
    .collection-list__container[data-desktop-alignment='left'] {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto auto;
      grid-template-areas:
        'header actions navigation'
        'content content content';
      column-gap: var(--collection-list-gap, 40px);
      row-gap: var(--collection-list-gap, 40px);
    }

    .collection-list__container[data-desktop-alignment='center'] {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'header'
        'navigation'
        'content'
        'actions';
      row-gap: var(--collection-list-gap, 40px);
    }

    .collection-list__header {
      grid-area: header;
    }

    .collection-list__actions {
      grid-area: actions;
    }

    .collection-list__content {
      display: contents;
    }

    .collection-list__content > .collection-card-list {
      display: contents;
    }

    .collection-list__content > .collection-card-list > .collection-card-list__carousel-wrap {
      grid-area: content;
    }

    .collection-list__content > .collection-card-list > .collection-card-list__navigation--top {
      grid-area: navigation;
      align-self: end;
      margin-block-end: 0;
    }

    .collection-list__container[data-desktop-alignment='left'] .collection-list__header {
      justify-content: flex-start;
    }

    .collection-list__container[data-desktop-alignment='center'] .collection-list__header {
      align-items: center;
      justify-content: center;
    }

    .collection-list__container[data-desktop-alignment='left'] .collection-list__actions {
      align-self: end;
    }

    .collection-list__container[data-desktop-alignment='center'] .collection-list__actions,
    .collection-list__container[data-desktop-alignment='center'] .collection-card-list__navigation--top {
      justify-content: center;
      justify-self: center;
    }
  }

  @media (max-width: 767.98px) {
    .collection-list__spacing {
      padding-top: var(--collection-list-padding-top-mobile, var(--collection-list-padding-top, 50px));
      padding-bottom: var(--collection-list-padding-bottom-mobile, var(--collection-list-padding-bottom, 50px));
    }

    .collection-list__container {
      display: flex;
      flex-direction: column;
      gap: var(--collection-list-gap-mobile, var(--collection-list-gap, 40px));
    }

    .collection-list__header {
      display: contents;
      margin-bottom: 0;
    }

    .collection-list__header > .block-header {
      order: 1;
      align-self: var(--collection-list-justify-mobile, start);
    }

    .collection-list__content {
      order: 2;
    }

    .collection-list__actions {
      order: 3;
      align-self: var(--collection-list-justify-mobile, start);
      width: 100%;
    }

    .collection-list__actions .collection-list-view-all,
    .collection-list__actions .collection-list-view-all__button--mobile {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection_list",
  "class": "section-collection-list",
  "enabled_on": { "templates": ["*"] },
  "settings": [
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:labels.section_width",
      "options": [
        { "value": "page_width", "label": "t:options.section_width.page_width" },
        { "value": "full_width", "label": "t:options.section_width.full_width" }
      ],
      "default": "page_width"
    },
    {
      "type": "select",
      "id": "desktop_alignment",
      "label": "t:labels.alignment",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "mobile_alignment",
      "label": "t:labels.mobile_alignment",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" },
        { "value": "right", "label": "t:options.alignment.right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:general.gap"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "t:labels.desktop_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "t:labels.mobile_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "t:general.appearance"
    },
    {
      "type": "select",
      "id": "background_media",
      "label": "t:general.media",
      "options": [
        { "value": "none", "label": "t:options.background_media.none" },
        { "value": "image", "label": "t:general.image" },
        { "value": "video", "label": "t:general.video" }
      ],
      "default": "none"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.background_image",
      "visible_if": "{{ section.settings.background_media == 'image' }}"
    },
    {
      "type": "video",
      "id": "background_video",
      "label": "t:labels.background_video",
      "visible_if": "{{ section.settings.background_media == 'video' }}"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:general.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:options.position.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:options.position.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 50
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_padding",
      "label": "t:labels.customize_mobile_padding",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:labels.mobile_top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 50,
      "visible_if": "{{ section.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:labels.mobile_bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 50,
      "visible_if": "{{ section.settings.customize_mobile_padding }}"
    }
  ],
  "presets": [
    {
      "name": "t:general.collection_list",
      "category": "t:general.collections",
      "blocks": [
        { "type": "header", "id": "header", "static": true, "blocks": [{ "type": "heading", "settings": { "text": "<p>Collection list</p>", "html_tag": "h2" } }] },
        { "type": "view-all-button", "id": "view-all", "static": true },
        { "type": "collection-list-items", "id": "collection-list", "static": true, "blocks": [{ "type": "collection-card", "id": "collection-card", "static": true, "blocks": [{ "type": "collection-card-title", "id": "title", "static": true }] }] }
      ]
    }
  ]
}
{% endschema %}
