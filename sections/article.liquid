{% comment %}
  Article page composition. The article object is supplied by the article template.
{% endcomment %}

{% liquid
  assign article_posts_gap_desktop = section.settings.gap_desktop | default: 50 | plus: 0
  assign article_posts_gap_mobile = section.settings.gap_mobile | default: 30 | plus: 0
%}

<div
  class="section-spacing article-posts color-scheme {{ section.settings.color_scheme | default: 'scheme-1' }}"
  style="
    --article-posts-max-width: {{ section.settings.max_width }}px;
    --article-posts-padding-top: {{ section.settings.padding_top }}px;
    --article-posts-padding-bottom: {{ section.settings.padding_bottom }}px;
    --article-posts-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --article-posts-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="container page-width article-posts__container">
    {% capture article_posts_blocks_style %}
      {% render 'layout-flow-style',
        direction: 'column',
        wrap: 'nowrap',
        align_items: 'stretch',
        gap: article_posts_gap_desktop,
        gap_mobile: article_posts_gap_mobile
      %}
    {% endcapture %}
    {% assign article_posts_blocks_style = article_posts_blocks_style | strip %}
    <div class="article-posts__blocks layout-flow layout-flow--responsive" style="{{ article_posts_blocks_style }}">
      {% content_for 'block', type: 'blog-meta', id: 'blog-meta' %}
      {% content_for 'block', type: 'featured-image', id: 'featured-image' %}
      {% content_for 'block', type: 'content', id: 'content' %}
      {% content_for 'block', type: 'tags-and-sharing', id: 'tags-and-sharing' %}
      {% content_for 'block', type: 'divider', id: 'divider' %}
      {% content_for 'block', type: 'previous-and-next-posts', id: 'previous-and-next-posts' %}
      {% content_for 'block', type: 'comments', id: 'comments' %}
    </div>
  </div>
</div>

{% stylesheet %}
  .article-posts {
    padding-top: var(--article-posts-padding-top, 100px);
    padding-bottom: var(--article-posts-padding-bottom, 120px);
  }
  .article-posts__container { max-width: var(--article-posts-max-width, 1280px); margin-inline: auto; }
  .article-posts__blocks { min-width: 0; }
  @media (max-width: 767.98px) {
    .article-posts { padding-top: var(--article-posts-padding-top-mobile, var(--article-posts-padding-top, 100px)); padding-bottom: var(--article-posts-padding-bottom-mobile, var(--article-posts-padding-bottom, 120px)); }
    .article-posts__container { max-width: 100%; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Blog post",
  "tag": "div",
  "class": "article-posts-section",
  "enabled_on": { "templates": ["article"] },
  "blocks": [
    { "type": "blog-meta" },
    { "type": "featured-image" },
    { "type": "content" },
    { "type": "tags-and-sharing" },
    { "type": "divider" },
    { "type": "previous-and-next-posts" },
    { "type": "comments" }
  ],
  "max_blocks": 7,
  "settings": [
    { "type": "range", "id": "max_width", "label": "Max width", "min": 400, "max": 1600, "step": 20, "unit": "px", "default": 1280 },
    { "type": "header", "content": "Gap" },
    { "type": "range", "id": "gap_desktop", "label": "Desktop", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 50 },
    { "type": "range", "id": "gap_mobile", "label": "Mobile", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 30 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 100 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 120 },
    { "type": "checkbox", "id": "custom_mobile_padding", "label": "Custom for mobile", "default": false },
    { "type": "range", "id": "padding_top_mobile", "label": "Top (mobile)", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 50, "visible_if": "{{ section.settings.custom_mobile_padding }}" },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom (mobile)", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 60, "visible_if": "{{ section.settings.custom_mobile_padding }}" }
  ]
}
{% endschema %}
