{% doc %}
  Renders the Product media lightbox owned by the Product media block.

  @param {product} product - Product whose media is displayed
  @param {string} [id] - Optional stable Swiper root ID
  @param {string} [controls_color_scheme] - Optional color scheme for lightbox navigation
{% enddoc %}

{% liquid
  assign lightbox_media_count = 0
  for media in product.media
    if media.media_type == 'image' or media.preview_image != blank
      assign lightbox_media_count = lightbox_media_count | plus: 1
    endif
  endfor
%}

<dialog class="product-media-lightbox" data-product-media-lightbox aria-label="{{ 'products.media_gallery' | t: product: product.title | escape }}">
  <div class="product-media-lightbox__panel">
    <div class="product-media-lightbox__toolbar">
      <p class="product-media-lightbox__counter visually-hidden body-text body-sm" aria-live="polite">
        <span data-product-lightbox-current>1</span>
        <span aria-hidden="true">/</span>
        <span data-product-lightbox-total>{{ lightbox_media_count }}</span>
      </p>
      <button class="overlay-close product-media-lightbox__close" type="button" aria-label="{{ 'products.close_media' | t | escape }}" data-product-lightbox-close>
        {% render 'icon', icon: 'x-mark', bare: true, class: 'overlay-close__icon' %}
      </button>
    </div>

    {% if lightbox_media_count > 1 %}
      <button class="product-media-lightbox__navigation product-media-lightbox__navigation--previous icon-button swiper-nav-button swiper-nav-button--prev{% if controls_color_scheme != blank %} color-scheme {{ controls_color_scheme }}{% endif %}" type="button" aria-label="{{ 'products.previous_media' | t | escape }}" data-product-lightbox-previous>
        {% render 'icon', icon: 'chevron-left', bare: true %}
      </button>
    {% endif %}

    {% capture product_media_lightbox_content %}
      {% for media in product.media %}
        {% if media.media_type == 'image' or media.preview_image != blank %}
          {% assign lightbox_image = media.preview_image %}
          {% if media.media_type == 'image' %}{% assign lightbox_image = media %}{% endif %}
          {% assign lightbox_alt = media.alt | default: product.title %}
          <figure class="swiper-slide product-media-lightbox__slide" data-product-lightbox-slide data-media-id="{{ media.id }}" tabindex="0" role="button" aria-pressed="false" aria-label="{{ 'products.view_media' | t: index: forloop.index | escape }}">
            {{ lightbox_image | image_url: width: 2000 | image_tag: loading: 'lazy', class: 'product-media-lightbox__image', alt: lightbox_alt }}
          </figure>
        {% endif %}
      {% endfor %}
    {% endcapture %}

    {% render 'swiper-carousel',
      id: id,
      content: product_media_lightbox_content,
      root_class: 'product-media-lightbox__viewport',
      root_attributes: 'data-product-lightbox-swiper'
    %}

    {% if lightbox_media_count > 1 %}
      <div class="product-media-lightbox__thumbnails" data-product-lightbox-thumbnails role="group" aria-label="{{ 'products.media_thumbnails' | t | escape }}">
        {% for media in product.media %}
          {% if media.media_type == 'image' or media.preview_image != blank %}
            {% liquid
              assign lightbox_thumbnail_image = media.preview_image
              if media.media_type == 'image'
                assign lightbox_thumbnail_image = media
              endif
              assign lightbox_thumbnail_alt = media.alt | default: product.title
            %}
            <button class="product-media-lightbox__thumbnail" type="button" data-product-lightbox-thumbnail data-media-id="{{ media.id }}" aria-current="false" aria-label="{{ 'products.view_media' | t: index: forloop.index | escape }}">
              {{ lightbox_thumbnail_image | image_url: width: 180 | image_tag: widths: '80, 120, 180', sizes: '72px', loading: 'lazy', alt: lightbox_thumbnail_alt }}
            </button>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    {% if lightbox_media_count > 1 %}
      <button class="product-media-lightbox__navigation product-media-lightbox__navigation--next icon-button swiper-nav-button swiper-nav-button--next{% if controls_color_scheme != blank %} color-scheme {{ controls_color_scheme }}{% endif %}" type="button" aria-label="{{ 'products.next_media' | t | escape }}" data-product-lightbox-next>
        {% render 'icon', icon: 'chevron-right', bare: true %}
      </button>
    {% endif %}
  </div>
</dialog>
