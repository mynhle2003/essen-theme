    --pcard-show-vendor: {{ product_card_vendor }};
    --pcard-show-type: {{ product_card_type }};
    --pcard-swatch-enabled: {{ product_card_swatches_enabled }};
    --pcard-swatch-position: {{ product_card_swatch_position }};
    --pcard-swatch-type: {{ product_card_swatch_type }};
    --pcard-swatch-limit: {{ product_card_swatch_limit }};
    --pcard-swatch-gap: {{ product_card_swatch_gap }}px;
    --pcard-swatch-width: {{ product_card_swatch_width_desktop }}px;
    --pcard-swatch-width-mobile: {{ product_card_swatch_width_mobile }}px;
    --pcard-swatch-ratio: {{ product_card_swatch_ratio }};
    --pcard-swatch-selected-style: {{ product_card_swatch_selected_style }};

    /* Legacy aliases remain valid for existing product-card styles. */
    --product-card-ratio: {{ product_card_ratio }};
    --product-card-alignment: var(--pcard-alignment);
    --product-card-secondary: var(--pcard-show-secondary-image);

    --variant-height: {{ variant_height_desktop }}px;
    --variant-height-mobile: {{ variant_height_mobile }}px;
    --variant-group-gap: {{ variant_group_gap }}px;
    --variant-label-spacing: {{ variant_label_spacing }}px;
    --variant-item-gap: {{ variant_item_gap }}px;
    --variant-radius: {{ variant_radius }};
    --variant-border-width: {{ variant_border_width }};

    --swatch-style: {{ swatch_style }};
    --swatch-width: {{ swatch_width_desktop }}px;
    --swatch-width-mobile: {{ swatch_width_mobile }}px;
    --swatch-height-ratio: {{ swatch_height_ratio }};
    --swatch-selected-style: {{ swatch_selected_style }};
    --swatch-radius: {{ swatch_radius }};

    --badge-radius: {{ badge_radius }};
    --subheading-radius: {{ radius_badges_subheadings }};
    --navigation-radius: {{ radius_navigation }};
    --tag-radius: {{ radius_tags }};
    --drawer-radius: {{ drawer_radius }};
    --overlay-close-radius: {{ overlay_close_radius }};
    --bottom-sheet-radius: {{ bottom_sheet_radius }};
    --overlay-radius: {{ overlay_radius }};
    --badge-font-family: var(--font-body-family);
    --badge-font-size: var(--font-body-xs);
    --badge-font-weight: 600;
    --badge-letter-spacing: var(--font-body-letter-spacing);
    --badge-padding: 0.2rem 0.55rem;
    --badge-sale-price: {{ badge_sale_price }};
    --badge-sale-background: {{ badge_sale_background }};
    --badge-sale-color: {{ badge_sale_color }};
    --badge-sold-out-background: {{ badge_sold_out_background }};
    --badge-sold-out-color: {{ badge_sold_out_color }};

    --price-font-family: var(--font-body-family);
    --price-font-style: var(--font-body-style);
    --price-font-size: var(--font-body-md);
    --price-font-weight: var(--font-body-weight);
    --price-line-height: var(--font-body-line-height);
    --price-sale-color: var(--badge-sale-price);
    --price-compare-color: var(--body-color);
    --price-unit-color: var(--body-color);

    --overlay-background-color: {{ overlay_background }};
    --overlay-text-color: {{ overlay_text_color }};
    --overlay-border-color: {{ overlay_border_color }};
    --overlay-shadow-color: {{ overlay_shadow_color }};
    --overlay-color: {{ overlay_color }};
    --overlay-opacity: {{ overlay_opacity | divided_by: 100.0 }};
    --overlay-backdrop-blur: {{ overlay_backdrop_blur }}px;
    --overlay-popover-border-width: {{ overlay_popover_border_width }}px;
    --overlay-popover-shadow: {{ overlay_popover_shadow }};
    --overlay-title-size: {{ overlay_title_size }};
    --overlay-drawer-padding-desktop: {{ overlay_drawer_padding_desktop }};
    --overlay-drawer-padding-mobile: {{ overlay_drawer_padding_mobile }};
    --z-base: {{ overlay_z_base }};
    --z-drawer: {{ overlay_z_drawer }};
    --z-modal: {{ overlay_z_modal }};
  }

  @media (min-width: 768px) and (max-width: 1149.98px) {
    :root {
      --font-heading-xs: {{ heading_6_size_desktop | times: 0.875 }}px;
      --font-heading-sm: {{ heading_5_size_desktop | times: 0.875 }}px;
      --font-heading-md: {{ heading_4_size_desktop | times: 0.875 }}px;
      --font-heading-lg: {{ heading_3_size_desktop | times: 0.875 }}px;
      --font-heading-xl: {{ heading_2_size_desktop | times: 0.875 }}px;
      --font-heading-display: {{ heading_1_size_desktop | times: 0.875 }}px;
    }
  }

  @media (max-width: 767.98px) {
    :root {
      --font-heading-xs: {{ heading_6_size_mobile }}px;
      --font-heading-sm: {{ heading_5_size_mobile }}px;
      --font-heading-md: {{ heading_4_size_mobile }}px;
      --font-heading-lg: {{ heading_3_size_mobile }}px;
      --font-heading-xl: {{ heading_2_size_mobile }}px;
      --font-heading-display: {{ heading_1_size_mobile }}px;
    }
  }

  {% for scheme in settings.color_schemes %}
    {% assign scheme_body = scheme.settings.text | default: default_body %}
    {% assign scheme_body_rgb = scheme_body | color_to_rgb | remove: 'rgb(' | remove: ')' | replace: ',', ' ' | strip %}
    .{{ scheme.id }} {
      --background-color: {{ scheme.settings.background }};
      --heading-color: {{ scheme.settings.heading }};
      --heading-highlight-color: {{ scheme.settings.heading_highlight }};
      --body-color: {{ scheme.settings.text }};
      --color-foreground-rgb: {{ scheme_body_rgb }};
      --accent-color: {{ scheme.settings.accent }};
      --border-color: {{ scheme.settings.border }};
      --shadow-color: {{ scheme.settings.shadow }};
      --sale-price-color: {{ scheme.settings.sale_price }};
      --button-primary-background: {{ scheme.settings.button_primary_background }};
      --button-primary-text: {{ scheme.settings.button_primary_text }};
      --button-primary-border: {{ scheme.settings.button_primary_border }};
      --button-primary-hover-background: {% if scheme.settings.button_primary_hover_background != blank %}{{ scheme.settings.button_primary_hover_background }}{% else %}transparent{% endif %};
      --button-primary-hover-text: {{ scheme.settings.button_primary_hover_text }};
      --button-primary-hover-border: {{ scheme.settings.button_primary_hover_border }};
      --button-secondary-background: {{ scheme.settings.button_secondary_background }};
      --button-secondary-text: {{ scheme.settings.button_secondary_text }};
      --button-secondary-border: {{ scheme.settings.button_secondary_border }};
      --button-secondary-hover-background: {% if scheme.settings.button_secondary_hover_background != blank %}{{ scheme.settings.button_secondary_hover_background }}{% else %}transparent{% endif %};
      --button-secondary-hover-text: {{ scheme.settings.button_secondary_hover_text }};
      --button-secondary-hover-border: {{ scheme.settings.button_secondary_hover_border }};
      --button-tertiary-background: transparent;
      --button-tertiary-text: {{ scheme.settings.button_tertiary_text }};
      --button-tertiary-border: transparent;
      --button-tertiary-hover-background: transparent;
      --button-tertiary-hover-text: {{ scheme.settings.button_tertiary_hover_text }};
      --button-tertiary-hover-border: transparent;

      --color-background: var(--background-color);
      --color-foreground: var(--body-color);
      --color-accent: var(--accent-color);
      --color-border: var(--border-color);
      --color-surface: color-mix(in srgb, var(--background-color) 94%, var(--body-color));
      --button-background: var(--button-{{ button_default_variant }}-background);
      --button-foreground: var(--button-{{ button_default_variant }}-text);
      --button-border: var(--button-{{ button_default_variant }}-border);
      --button-hover-background: var(--button-{{ button_default_variant }}-hover-background);
      --button-hover-foreground: var(--button-{{ button_default_variant }}-hover-text);
      --button-hover-border: var(--button-{{ button_default_variant }}-hover-border);
    }
  {% endfor %}
{% endstyle %}
