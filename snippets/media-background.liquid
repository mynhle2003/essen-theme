{% doc %}
  Renders responsive image or muted uploaded video media for a media-led surface.

  Image markup is delegated to the shared image snippet. Videos are rendered as
  decorative background media without interactive playback controls.

  @param {string} media_type - The media type, either image or video
  @param {image} [image] - The desktop image
  @param {image} [mobile_image] - The mobile image
  @param {video} [video] - The desktop uploaded video
  @param {video} [mobile_video] - The mobile uploaded video
  @param {string} [alt] - Optional image alternative text
  @param {string} [sizes] - Responsive image sizes
  @param {boolean} [aria_hidden] - Whether the media should be hidden from assistive technology
  @param {string} [class] - Optional class for the media wrapper
{% enddoc %}

{% liquid
  assign background_media_type = media_type | default: 'image'
  unless background_media_type == 'image' or background_media_type == 'video'
    assign background_media_type = 'image'
  endunless

  assign background_media_image = image
  if background_media_image == blank
    assign background_media_image = mobile_image
  endif

  assign background_media_video = video
  if background_media_video == blank
    assign background_media_video = mobile_video
  endif

  assign has_distinct_mobile_video = false
  if video != blank and mobile_video != blank
    assign has_distinct_mobile_video = true
  endif

  assign background_media_class = 'background-media'
  if has_distinct_mobile_video
    assign background_media_class = background_media_class | append: ' background-media--has-mobile-video'
  endif
%}

<div
  class="{{ background_media_class }} {{ class }}"
  {% if aria_hidden %}aria-hidden="true"{% endif %}
>
  {% if background_media_type == 'video' %}
    {% if background_media_video != blank %}
      <div class="background-media__video background-media__video--desktop">
        {{ background_media_video | video_tag: image_size: '1600x', autoplay: true, loop: true, muted: true, controls: false, loading: 'lazy' }}
      </div>
      {% if has_distinct_mobile_video %}
        <div class="background-media__video background-media__video--mobile">
          {{ mobile_video | video_tag: image_size: '1600x', autoplay: true, loop: true, muted: true, controls: false, loading: 'lazy' }}
        </div>
      {% endif %}
    {% else %}
      {{ 'product-1' | placeholder_svg_tag: 'background-media__placeholder' }}
    {% endif %}
  {% else %}
    {% render 'image',
      image: background_media_image,
      mobile_image: mobile_image,
      alt: alt,
      class: 'background-media__image',
      width: 2400,
      widths: '480, 720, 960, 1200, 1600, 2400',
      sizes: sizes
    %}
  {% endif %}
</div>

{% stylesheet %}
  .background-media {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background-color: var(--background-color);
  }

  .background-media__image,
  .background-media__image > picture,
  .background-media__image > img,
  .background-media__image .image__placeholder,
  .background-media__video,
  .background-media__video > video,
  .background-media__placeholder {
    display: block;
    width: 100%;
    height: 100%;
  }

  .background-media__image > picture,
  .background-media__image > img,
  .background-media__image .image__placeholder {
    max-width: none;
  }

  .background-media__image > img,
  .background-media__image > picture > img,
  .background-media__image .image__placeholder,
  .background-media__video > video,
  .background-media__placeholder {
    object-fit: cover;
  }

  .background-media__video > video {
    pointer-events: none;
  }

  .background-media__video--mobile {
    display: none;
  }

  @media (max-width: 767.98px) {
    .background-media--has-mobile-video .background-media__video--desktop {
      display: none;
    }

    .background-media--has-mobile-video .background-media__video--mobile {
      display: block;
    }
  }
{% endstylesheet %}
