{% doc %}
  Renders a UI icon from the registered icon library or a checked custom SVG.

  The block owns icon source, link behavior, local icon sizing and outer
  padding. The shared icon snippet owns icon markup and safe link semantics.

  @example
  {% content_for 'block', type: 'icon', id: 'icon' %}
{% enddoc %}

{% liquid
  assign icon_source = block.settings.source | default: 'library'
  unless icon_source == 'library' or icon_source == 'custom'
    assign icon_source = 'library'
  endunless

  assign icon_name = block.settings.icon | default: 'arrow-right'
  unless icon_name == 'arrow' or icon_name == 'arrow-left' or icon_name == 'arrow-right' or icon_name == 'bars-3' or icon_name == 'menu' or icon_name == 'chevron-down' or icon_name == 'chevron-left' or icon_name == 'chevron-right' or icon_name == 'x-mark' or icon_name == 'close' or icon_name == 'magnifying-glass' or icon_name == 'search' or icon_name == 'shopping-bag' or icon_name == 'bag' or icon_name == 'cart' or icon_name == 'shopping-cart' or icon_name == 'user' or icon_name == 'account' or icon_name == 'truck' or icon_name == 'shipping' or icon_name == 'tag' or icon_name == 'discount' or icon_name == 'trash' or icon_name == 'remove' or icon_name == 'document-text' or icon_name == 'note' or icon_name == 'receipt-percent' or icon_name == 'coupon' or icon_name == 'share' or icon_name == 'play' or icon_name == 'pause' or icon_name == 'plus' or icon_name == 'minus' or icon_name == 'check' or icon_name == 'circle' or icon_name == 'square' or icon_name == 'triangle' or icon_name == 'diamond'
    assign icon_name = 'arrow-right'
  endunless

  assign icon_translation_name = icon_name | replace: '-', '_'
  case icon_name
    when 'menu'
      assign icon_translation_name = 'bars_3'
    when 'chevron'
      assign icon_translation_name = 'chevron_down'
    when 'close'
      assign icon_translation_name = 'x_mark'
    when 'search'
      assign icon_translation_name = 'magnifying_glass'
    when 'bag'
      assign icon_translation_name = 'shopping_bag'
    when 'shipping'
      assign icon_translation_name = 'truck'
    when 'discount'
      assign icon_translation_name = 'tag'
    when 'remove'
      assign icon_translation_name = 'trash'
    when 'note'
      assign icon_translation_name = 'document_text'
    when 'coupon'
      assign icon_translation_name = 'receipt_percent'
  endcase

  assign icon_label = blank
  if icon_source == 'library'
    assign icon_label_key = 'accessibility.icon_' | append: icon_translation_name
    assign icon_label = icon_label_key | t
  endif

  assign icon_width = block.settings.icon_width | default: 24 | plus: 0
  if icon_width < 6 or icon_width > 100
    assign icon_width = 24
  endif
  assign icon_padding = block.settings.icon_padding | default: 0 | plus: 0
  if icon_padding < 0 or icon_padding > 100
    assign icon_padding = 0
  endif

  assign icon_width_mobile = icon_width
  assign icon_padding_mobile = icon_padding
  if block.settings.custom_mobile
    assign icon_width_mobile = block.settings.icon_width_mobile | default: 24 | plus: 0
    if icon_width_mobile < 8 or icon_width_mobile > 100
      assign icon_width_mobile = 24
    endif
    assign icon_padding_mobile = block.settings.icon_padding_mobile | default: 0 | plus: 0
    if icon_padding_mobile < 0 or icon_padding_mobile > 100
      assign icon_padding_mobile = 0
    endif
  endif

  assign padding_top = block.settings.padding_top | default: 0 | plus: 0
  assign padding_bottom = block.settings.padding_bottom | default: 0 | plus: 0
  assign padding_left = block.settings.padding_left | default: 0 | plus: 0
  assign padding_right = block.settings.padding_right | default: 0 | plus: 0
  assign padding_top_mobile = block.settings.padding_top_mobile | default: 0 | plus: 0
  assign padding_bottom_mobile = block.settings.padding_bottom_mobile | default: 0 | plus: 0
  assign padding_left_mobile = block.settings.padding_left_mobile | default: 0 | plus: 0
  assign padding_right_mobile = block.settings.padding_right_mobile | default: 0 | plus: 0

  assign icon_class = 'icon-block'
  if icon_source == 'custom'
    assign icon_class = icon_class | append: ' icon-block--custom'
  endif
%}

{% capture icon_style %}
  --icon-block-width: {{ icon_width }}px;
  --icon-block-padding: {{ icon_padding }}px;
  --icon-block-width-mobile: {{ icon_width_mobile }}px;
  --icon-block-padding-mobile: {{ icon_padding_mobile }}px;
  --icon-block-padding-top: {{ padding_top }}px;
  --icon-block-padding-bottom: {{ padding_bottom }}px;
  --icon-block-padding-left: {{ padding_left }}px;
  --icon-block-padding-right: {{ padding_right }}px;
  --icon-block-padding-top-mobile: {{ padding_top_mobile }}px;
  --icon-block-padding-bottom-mobile: {{ padding_bottom_mobile }}px;
  --icon-block-padding-left-mobile: {{ padding_left_mobile }}px;
  --icon-block-padding-right-mobile: {{ padding_right_mobile }}px;
{% endcapture %}
{% assign icon_style = icon_style | strip | replace: '\n', ' ' %}

<div
  class="{{ icon_class }}"
  style="{{ icon_style }}"
  {{ block.shopify_attributes }}
>
  {% render 'icon',
    icon: icon_name,
    source: icon_source,
    custom_icon: block.settings.custom_icon,
    url: block.settings.icon_link,
    label: icon_label,
    open_in_new_tab: block.settings.open_in_new_tab,
    class: 'icon-block__icon'
  %}
</div>

{% stylesheet %}
  .icon-block {
    display: block;
    width: fit-content;
    max-width: 100%;
    min-width: 0;
    line-height: 0;
    padding-top: var(--icon-block-padding-top, 0px);
    padding-right: var(--icon-block-padding-right, 0px);
    padding-bottom: var(--icon-block-padding-bottom, 0px);
    padding-left: var(--icon-block-padding-left, 0px);
    color: inherit;
  }

  .icon-block__icon {
    --icon-width: var(--icon-block-width, 24px);
    --icon-padding: var(--icon-block-padding, 0px);
  }

  @media (max-width: 767.98px) {
    .icon-block {
      padding-top: var(--icon-block-padding-top-mobile, var(--icon-block-padding-top, 0px));
      padding-right: var(--icon-block-padding-right-mobile, var(--icon-block-padding-right, 0px));
      padding-bottom: var(--icon-block-padding-bottom-mobile, var(--icon-block-padding-bottom, 0px));
      padding-left: var(--icon-block-padding-left-mobile, var(--icon-block-padding-left, 0px));
    }

    .icon-block__icon {
      --icon-width: var(--icon-block-width-mobile, var(--icon-block-width, 24px));
      --icon-padding: var(--icon-block-padding-mobile, var(--icon-block-padding, 0px));
    }
  }
{% endstylesheet %}

