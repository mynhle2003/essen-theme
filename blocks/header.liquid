{% doc %}
  Renders a compound header block that stacks optional Eyebrow, Heading, and
  Text child blocks.

  The parent section owns the outer layout and alignment. This block owns the
  child flow, optional max width, gaps, and padding without overriding child
  typography.

  @example
  {% content_for 'block', type: 'header', id: 'header' %}
{% enddoc %}

{% liquid
  assign header_width_mode = block.settings.width
  if header_width_mode == blank
    assign header_width_mode = 'fit'
    if block.settings.limit_width
      assign header_width_mode = 'custom'
    endif
  endif
  unless header_width_mode == 'fit' or header_width_mode == 'fill' or header_width_mode == 'custom'
    assign header_width_mode = 'fit'
  endunless

  assign header_width = '100%'
  if header_width_mode == 'fit'
    assign header_width = 'fit-content'
  endif

  assign header_max_width = block.settings.max_width | default: 750 | plus: 0
  if header_max_width < 320 or header_max_width > 1200
    assign header_max_width = 750
  endif

  assign header_width_mobile_mode = header_width_mode
  assign header_width_mobile = header_width
  assign header_max_width_mobile = header_max_width
  if block.settings.customize_mobile_size
    assign header_width_mobile_mode = block.settings.width_mobile | default: header_width_mode
    unless header_width_mobile_mode == 'fit' or header_width_mobile_mode == 'fill' or header_width_mobile_mode == 'custom'
      assign header_width_mobile_mode = header_width_mode
    endunless

    assign header_width_mobile = '100%'
    if header_width_mobile_mode == 'fit'
      assign header_width_mobile = 'fit-content'
    endif

    assign header_max_width_mobile = block.settings.max_width_mobile | default: 480 | plus: 0
    if header_max_width_mobile < 240 or header_max_width_mobile > 800
      assign header_max_width_mobile = 480
    endif
  endif

  assign header_gap_desktop = block.settings.gap_desktop | default: 12 | plus: 0
  if header_gap_desktop < 0 or header_gap_desktop > 100
    assign header_gap_desktop = 12
  endif

  assign header_gap_mobile = block.settings.gap_mobile | default: 8 | plus: 0
  if header_gap_mobile < 0 or header_gap_mobile > 100
    assign header_gap_mobile = 8
  endif

  assign padding_top = block.settings.padding_top | default: 0 | plus: 0
  assign padding_bottom = block.settings.padding_bottom | default: 0 | plus: 0
  assign padding_left = block.settings.padding_left | default: 0 | plus: 0
  assign padding_right = block.settings.padding_right | default: 0 | plus: 0
  assign padding_top_mobile = block.settings.padding_top_mobile | default: 0 | plus: 0
  assign padding_bottom_mobile = block.settings.padding_bottom_mobile | default: 0 | plus: 0
  assign padding_left_mobile = block.settings.padding_left_mobile | default: 0 | plus: 0
  assign padding_right_mobile = block.settings.padding_right_mobile | default: 0 | plus: 0

  if padding_top < 0 or padding_top > 100
    assign padding_top = 0
  endif
  if padding_bottom < 0 or padding_bottom > 100
    assign padding_bottom = 0
  endif
  if padding_left < 0 or padding_left > 100
    assign padding_left = 0
  endif
  if padding_right < 0 or padding_right > 100
    assign padding_right = 0
  endif
  if padding_top_mobile < 0 or padding_top_mobile > 100
    assign padding_top_mobile = 0
  endif
  if padding_bottom_mobile < 0 or padding_bottom_mobile > 100
    assign padding_bottom_mobile = 0
  endif
  if padding_left_mobile < 0 or padding_left_mobile > 100
    assign padding_left_mobile = 0
  endif
  if padding_right_mobile < 0 or padding_right_mobile > 100
    assign padding_right_mobile = 0
  endif
%}

{% capture header_style %}
  {% render 'layout-flow-style',
    direction: 'column',
    wrap: 'nowrap',
    align_items: 'var(--flex-align, flex-start)',
    align_items_mobile: 'var(--flex-align-mobile, var(--flex-align, flex-start))',
    gap: header_gap_desktop,
    gap_mobile: header_gap_mobile
  %}
  {% if header_width_mode != 'fit' %}--header-width: {{ header_width }};{% endif %}
  {% if header_width_mode == 'custom' %}--header-max-width: {{ header_max_width }}px;{% endif %}
  {% if block.settings.customize_mobile_size %}
    {% if header_width_mobile != header_width %}--header-width-mobile: {{ header_width_mobile }};{% endif %}
    {% if header_width_mobile_mode == 'custom' %}
      {% if header_width_mode != 'custom' or header_max_width_mobile != header_max_width %}--header-max-width-mobile: {{ header_max_width_mobile }}px;{% endif %}
    {% elsif header_width_mode == 'custom' %}
      --header-max-width-mobile: 100%;
    {% endif %}
  {% endif %}
  {% if padding_top != 0 %}--header-padding-top: {{ padding_top }}px;{% endif %}
  {% if padding_bottom != 0 %}--header-padding-bottom: {{ padding_bottom }}px;{% endif %}
  {% if padding_left != 0 %}--header-padding-left: {{ padding_left }}px;{% endif %}
  {% if padding_right != 0 %}--header-padding-right: {{ padding_right }}px;{% endif %}
  {% if block.settings.customize_mobile_padding %}
    {% if padding_top_mobile != padding_top %}--header-padding-top-mobile: {{ padding_top_mobile }}px;{% endif %}
    {% if padding_bottom_mobile != padding_bottom %}--header-padding-bottom-mobile: {{ padding_bottom_mobile }}px;{% endif %}
    {% if padding_left_mobile != padding_left %}--header-padding-left-mobile: {{ padding_left_mobile }}px;{% endif %}
    {% if padding_right_mobile != padding_right %}--header-padding-right-mobile: {{ padding_right_mobile }}px;{% endif %}
  {% endif %}
{% endcapture %}
{% assign header_style = header_style | strip %}

<div
  class="block-header layout-flow layout-flow--responsive motion-block"
  {% if header_style != blank %}style="{{ header_style }}"{% endif %}
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .block-header {
    width: var(--header-width, fit-content);
    max-width: var(--header-max-width, 100%);
    min-width: 0;
    padding-top: var(--header-padding-top, 0px);
    padding-right: var(--header-padding-right, 0px);
    padding-bottom: var(--header-padding-bottom, 0px);
    padding-left: var(--header-padding-left, 0px);
  }

  .block-header > * {
    min-width: 0;
  }

  @media (max-width: 767.98px) {
    .block-header {
      width: var(--header-width-mobile, var(--header-width, fit-content));
      max-width: var(--header-max-width-mobile, var(--header-max-width, 100%));
      padding-top: var(--header-padding-top-mobile, var(--header-padding-top, 0px));
      padding-right: var(--header-padding-right-mobile, var(--header-padding-right, 0px));
      padding-bottom: var(--header-padding-bottom-mobile, var(--header-padding-bottom, 0px));
      padding-left: var(--header-padding-left-mobile, var(--header-padding-left, 0px));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "tag": null,
  "blocks": [
    { "type": "eyebrow" },
    { "type": "heading" },
    { "type": "text" },
    { "type": "spacer" }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:general.size"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:labels.width",
      "options": [
        { "value": "fit", "label": "t:options.width.fit" },
        { "value": "fill", "label": "t:options.width.fill" },
        { "value": "custom", "label": "t:options.width.custom" }
      ],
      "default": "fit"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "t:labels.max_width",
      "min": 320,
      "max": 1200,
      "step": 10,
      "unit": "px",
      "default": 750,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_size",
      "label": "t:labels.customize_mobile_size",
      "default": false
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:labels.mobile_width",
      "options": [
        { "value": "fit", "label": "t:options.width.fit" },
        { "value": "fill", "label": "t:options.width.fill" },
        { "value": "custom", "label": "t:options.width.custom" }
      ],
      "default": "fit",
      "visible_if": "{{ block.settings.customize_mobile_size }}"
    },
    {
      "type": "range",
      "id": "max_width_mobile",
      "label": "t:labels.mobile_max_width",
      "min": 240,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 480,
      "visible_if": "{{ block.settings.customize_mobile_size and block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:general.gap"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "t:labels.desktop_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "t:labels.mobile_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "t:general.padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:labels.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:labels.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_padding",
      "label": "t:labels.customize_mobile_padding",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:labels.mobile_top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:labels.mobile_bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "t:labels.mobile_left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "t:labels.mobile_right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.customize_mobile_padding }}"
    }
  ],
  "presets": [
    {
      "name": "t:general.header",
      "category": "t:general.basic",
      "settings": {
        "width": "fit",
        "max_width": 750,
        "customize_mobile_size": false,
        "width_mobile": "fit",
        "max_width_mobile": 480,
        "gap_desktop": 12,
        "gap_mobile": 8,
        "customize_mobile_padding": false
      },
      "blocks": [
        {
          "type": "eyebrow",
          "settings": {
            "text": "<p>New arrivals</p>"
          }
        },
        {
          "type": "heading",
          "settings": {
            "text": "<p>Build your base</p>",
            "heading_size": "lg",
            "html_tag": "h2"
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "<p>A flexible header composition for editorial content and product stories.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
