{% doc %}
  Compatibility wrapper for the legacy nested product collection grid.
  Product List and Collection Tab use the shared product-collection-grid
  snippet directly so Product Card stays a direct child of their parent.

  @param {object} [collection] - Collection resource to render
  @param {number} [max_products] - Maximum number of products to render
  @param {string} [layout_type] - Grid or carousel presentation
  @param {string} [columns_desktop] - Desktop column setting
  @param {string} [columns_mobile] - Mobile column setting
  @param {boolean} [enable_swipe_mobile] - Whether to enable mobile swipe
  @param {number} [gap_horizontal] - Desktop horizontal gap in pixels
  @param {number} [gap_vertical] - Desktop vertical gap in pixels
  @param {number} [gap_horizontal_mobile] - Mobile horizontal gap in pixels
  @param {number} [gap_vertical_mobile] - Mobile vertical gap in pixels
  @param {boolean} [show_placeholders] - Whether to render placeholder cards
  @param {number} [placeholder_count] - Number of placeholder cards
  @param {string} [grid_class] - Additional class for the grid root
  @param {string} [item_class] - Additional class for each grid item
  @param {string} [items_data_attributes] - Additional grid data attributes
  @param {boolean} [autoplay] - Whether the carousel auto-rotates
  @param {boolean} [autoplay_pause_on_hover] - Whether pointer hover pauses autoplay
  @param {number} [autoplay_delay] - Autoplay delay in milliseconds
  @param {boolean} [product_card_override_enabled] - Whether to use legacy parent card settings
  @param {boolean} [product_card_show_ranking_override] - Legacy card ranking override
  @param {string} [product_card_color_type_override] - Legacy card color type override
  @param {object} [product_card_color_scheme_override] - Legacy card color scheme override
  @param {string} [product_card_editor_attributes_override] - Legacy card editor attributes

  This block remains only for compatibility with saved content that still has
  the old nested block tree. New Product List and Collection Tab instances do
  not render this wrapper.
{% enddoc %}

{% liquid
  assign product_collection_grid_card_block = block.blocks | first
%}

{% render 'product-collection-grid',
  collection: collection,
  max_products: max_products,
  layout_type: layout_type,
  columns_desktop: columns_desktop,
  columns_mobile: columns_mobile,
  enable_swipe_mobile: enable_swipe_mobile,
  gap_horizontal: gap_horizontal,
  gap_vertical: gap_vertical,
  gap_horizontal_mobile: gap_horizontal_mobile,
  gap_vertical_mobile: gap_vertical_mobile,
  show_placeholders: show_placeholders,
  show_placeholders_for_empty_collection: show_placeholders,
  placeholder_count: placeholder_count,
  grid_class: grid_class,
  item_class: item_class,
  items_data_attributes: items_data_attributes,
  autoplay: autoplay,
  autoplay_pause_on_hover: autoplay_pause_on_hover,
  autoplay_delay: autoplay_delay,
  product_card_block: product_collection_grid_card_block,
  product_card_override_enabled: product_card_override_enabled,
  product_card_show_ranking_override: product_card_show_ranking_override,
  product_card_color_type_override: product_card_color_type_override,
  product_card_color_scheme_override: product_card_color_scheme_override,
  product_card_editor_attributes_override: product_card_editor_attributes_override,
  grid_attributes: block.shopify_attributes
%}

{% schema %}
{
  "name": "t:general.product_list",
  "tag": null,
  "blocks": [
    { "type": "product-card" }
  ]
}
{% endschema %}
