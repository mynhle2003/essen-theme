{% doc %}
  Renders a responsive product collection using one controlled Product Card
  child for every product. The block owns the collection query, item count,
  grid/carousel layout, columns, and gaps; Product Card owns presentation.

  @example
  {% content_for 'block', type: 'product-list', id: 'product-list' %}
{% enddoc %}

{% liquid
  assign product_list_collection = block.settings.collection
  assign product_list_layout = block.settings.layout_type | default: 'grid'
  unless product_list_layout == 'grid' or product_list_layout == 'carousel'
    assign product_list_layout = 'grid'
  endunless

  assign product_list_product_card_block = block.blocks | first
  if product_list_product_card_block != blank and product_list_product_card_block.blocks != blank
    assign product_list_product_card_block = product_list_product_card_block.blocks | first
  endif

  assign product_list_carousel_id = 'ProductListCarousel-' | append: block.id
  assign product_list_aria_label = product_list_collection.title | default: 'search.products' | t
%}

{% if product_list_layout == 'carousel' %}
  {% render 'swiper-stylesheet' %}
  <script type="module" src="{{ 'product-collection-carousel.js' | asset_url }}"></script>
{% endif %}

<div
  class="product-list"
  data-product-list
  data-layout="{{ product_list_layout }}"
  {{ block.shopify_attributes }}
>
  <div class="product-list__carousel" data-product-list-carousel>
    {% render 'product-collection-grid',
      collection: product_list_collection,
      max_products: block.settings.max_products,
      layout_type: product_list_layout,
      columns_desktop: block.settings.columns_desktop,
      columns_mobile: block.settings.columns_mobile,
      enable_swipe_mobile: block.settings.enable_swipe_mobile,
      custom_columns: block.settings.custom_columns,
      custom_columns_desktop: block.settings.custom_columns_desktop,
      custom_columns_mobile: block.settings.custom_columns_mobile,
      gap_horizontal: block.settings.gap_horizontal,
      gap_vertical: block.settings.gap_vertical,
      gap_horizontal_mobile: block.settings.gap_horizontal_mobile,
      gap_vertical_mobile: block.settings.gap_vertical_mobile,
      show_placeholders: true,
      show_placeholders_for_empty_collection: true,
      placeholder_count: 8,
      grid_class: 'product-list__items',
      item_class: 'product-list__item',
      items_data_attributes: 'data-product-list-items',
      carousel_id: product_list_carousel_id,
      aria_label: product_list_aria_label,
      previous_selector: '[data-product-list-previous]',
      next_selector: '[data-product-list-next]',
      product_card_block: product_list_product_card_block
    %}

    {% if product_list_layout == 'carousel' %}
      <div class="product-list__navigation" data-product-list-navigation>
        <button
          class="btn btn-secondary btn--secondary btn--icon product-list__carousel-button"
          type="button"
          data-product-list-previous
          aria-label="{{ 'collection_tabs.previous' | t | escape }}"
        >
          {% render 'icon', icon: 'chevron-left', bare: true %}
        </button>
        <button
          class="btn btn-secondary btn--secondary btn--icon product-list__carousel-button"
          type="button"
          data-product-list-next
          aria-label="{{ 'collection_tabs.next' | t | escape }}"
        >
          {% render 'icon', icon: 'chevron-right', bare: true %}
        </button>
      </div>
    {% endif %}
  </div>
</div>

{% comment %}
  Keep the static Product Card target discoverable to Theme Check and the
  Theme Editor. The shared renderer uses the direct child settings for every
  item because content_for is not available inside snippets.
{% endcomment %}
{% if false %}
  {% content_for 'block', type: 'product-card', id: 'product-card' %}
{% endif %}

{% stylesheet %}
  .product-list {
    width: 100%;
    min-width: 0;
  }

  .product-list__carousel {
    position: relative;
    width: 100%;
    min-width: 0;
  }

  .product-list__navigation {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-block-start: 1rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product_list",
  "tag": null,
  "blocks": [
    { "type": "product-card" }
  ],
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "t:labels.max_products",
      "min": 1,
      "max": 24,
      "step": 1,
      "default": 6
    },
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:labels.type",
      "options": [
        { "value": "grid", "label": "t:options.product_list_layout.grid" },
        { "value": "carousel", "label": "t:options.product_list_layout.carousel" }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "t:labels.desktop_columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" }
      ],
      "default": "3",
      "visible_if": "{{ block.settings.custom_columns == false }}"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:labels.mobile_columns",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1",
      "visible_if": "{{ block.settings.custom_columns == false }}"
    },
    {
      "type": "checkbox",
      "id": "enable_swipe_mobile",
      "label": "t:labels.enable_swipe_mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "custom_columns",
      "label": "t:labels.custom_columns",
      "default": false
    },
    {
      "type": "range",
      "id": "custom_columns_desktop",
      "label": "t:labels.desktop_columns",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3,
      "visible_if": "{{ block.settings.custom_columns }}"
    },
    {
      "type": "range",
      "id": "custom_columns_mobile",
      "label": "t:labels.mobile_columns",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 1,
      "visible_if": "{{ block.settings.custom_columns }}"
    },
    {
      "type": "header",
      "content": "t:general.gap"
    },
    {
      "type": "range",
      "id": "gap_horizontal",
      "label": "t:labels.horizontal_gap",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "gap_vertical",
      "label": "t:labels.vertical_gap",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "gap_horizontal_mobile",
      "label": "t:labels.horizontal_gap_mobile",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "gap_vertical_mobile",
      "label": "t:labels.vertical_gap_mobile",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "t:general.product_list",
      "category": "t:general.product",
      "settings": {
        "collection": "",
        "max_products": 6,
        "layout_type": "grid",
        "columns_desktop": "3",
        "columns_mobile": "1",
        "enable_swipe_mobile": false,
        "custom_columns": false,
        "custom_columns_desktop": 3,
        "custom_columns_mobile": 1,
        "gap_horizontal": 4,
        "gap_vertical": 4,
        "gap_horizontal_mobile": 4,
        "gap_vertical_mobile": 4
      },
      "blocks": [
        {
          "type": "product-card",
          "id": "product-card",
          "static": true,
          "settings": {
            "show_ranking": false,
            "color_type": "inherit",
            "color_scheme": "scheme-1"
          }
        }
      ]
    }
  ]
}
{% endschema %}
