{% doc %}
  Renders an independent responsive image kernel with an optional link.

  The block owns its image source, responsive ratio, width, radius and padding,
  while the shared image snippet owns semantic media markup and image loading.

  @example
  {% content_for 'block', type: 'image', id: 'image' %}
{% enddoc %}

{% liquid
  assign image_source = block.settings.image
  assign mobile_image_source = block.settings.mobile_image

  assign image_ratio_desktop_setting = block.settings.image_ratio_desktop | default: 'auto'
  assign image_ratio_desktop = 'auto'
  assign image_height_desktop = 'auto'
  case image_ratio_desktop_setting
    when 'square'
      assign image_ratio_desktop = '1'
      assign image_height_desktop = '100%'
    when 'portrait'
      assign image_ratio_desktop = '0.8'
      assign image_height_desktop = '100%'
    when 'landscape'
      assign image_ratio_desktop = '1.3333'
      assign image_height_desktop = '100%'
    when 'wide'
      assign image_ratio_desktop = '1.7778'
      assign image_height_desktop = '100%'
    when 'custom'
      assign image_ratio_custom_width_desktop = block.settings.image_ratio_custom_width_desktop | default: 16 | plus: 0
      assign image_ratio_custom_height_desktop = block.settings.image_ratio_custom_height_desktop | default: 9 | plus: 0
      if image_ratio_custom_width_desktop < 1 or image_ratio_custom_width_desktop > 100
        assign image_ratio_custom_width_desktop = 16
      endif
      if image_ratio_custom_height_desktop < 1 or image_ratio_custom_height_desktop > 100
        assign image_ratio_custom_height_desktop = 9
      endif
      assign image_ratio_desktop = image_ratio_custom_width_desktop | times: 1.0 | divided_by: image_ratio_custom_height_desktop
      if image_ratio_desktop < 0.25 or image_ratio_desktop > 3
        assign image_ratio_desktop = 16 | divided_by: 9.0
      endif
      assign image_height_desktop = '100%'
    when 'auto'
    else
      assign image_ratio_desktop = 'auto'
  endcase

  assign image_ratio_mobile_setting = block.settings.image_ratio_mobile | default: 'auto'
  assign image_ratio_mobile = 'auto'
  assign image_height_mobile = 'auto'
  case image_ratio_mobile_setting
    when 'square'
      assign image_ratio_mobile = '1'
      assign image_height_mobile = '100%'
    when 'portrait'
      assign image_ratio_mobile = '0.8'
      assign image_height_mobile = '100%'
    when 'landscape'
      assign image_ratio_mobile = '1.3333'
      assign image_height_mobile = '100%'
    when 'wide'
      assign image_ratio_mobile = '1.7778'
      assign image_height_mobile = '100%'
    when 'custom'
      assign image_ratio_custom_width_mobile = block.settings.image_ratio_custom_width_mobile | default: 16 | plus: 0
      assign image_ratio_custom_height_mobile = block.settings.image_ratio_custom_height_mobile | default: 9 | plus: 0
      if image_ratio_custom_width_mobile < 1 or image_ratio_custom_width_mobile > 100
        assign image_ratio_custom_width_mobile = 16
      endif
      if image_ratio_custom_height_mobile < 1 or image_ratio_custom_height_mobile > 100
        assign image_ratio_custom_height_mobile = 9
      endif
      assign image_ratio_mobile = image_ratio_custom_width_mobile | times: 1.0 | divided_by: image_ratio_custom_height_mobile
      if image_ratio_mobile < 0.25 or image_ratio_mobile > 3
        assign image_ratio_mobile = 16 | divided_by: 9.0
      endif
      assign image_height_mobile = '100%'
    when 'auto'
    else
      assign image_ratio_mobile = 'auto'
  endcase

  assign image_width_desktop_setting = block.settings.width_desktop | default: 'fit'
  unless image_width_desktop_setting == 'fit' or image_width_desktop_setting == 'fill' or image_width_desktop_setting == 'custom'
    assign image_width_desktop_setting = 'fit'
  endunless
  assign image_width_desktop = 'fit-content'
  assign image_size_desktop = '100vw'
  if image_width_desktop_setting == 'fill'
    assign image_width_desktop = '100%'
  elsif image_width_desktop_setting == 'custom'
    assign image_width_desktop_value = block.settings.width_custom_desktop | default: 100 | plus: 0
    if image_width_desktop_value < 1 or image_width_desktop_value > 100
      assign image_width_desktop_value = 100
    endif
    assign image_width_desktop = image_width_desktop_value | append: '%'
    assign image_size_desktop = image_width_desktop
  endif

  assign image_width_mobile_setting = block.settings.width_mobile | default: 'fit'
  unless image_width_mobile_setting == 'fit' or image_width_mobile_setting == 'fill' or image_width_mobile_setting == 'custom'
    assign image_width_mobile_setting = 'fit'
  endunless
  assign image_width_mobile = 'fit-content'
  assign image_size_mobile = '100vw'
  if image_width_mobile_setting == 'fill'
    assign image_width_mobile = '100%'
  elsif image_width_mobile_setting == 'custom'
    assign image_width_mobile_value = block.settings.width_custom_mobile | default: 100 | plus: 0
    if image_width_mobile_value < 1 or image_width_mobile_value > 100
      assign image_width_mobile_value = 100
    endif
    assign image_width_mobile = image_width_mobile_value | append: '%'
    assign image_size_mobile = image_width_mobile
  endif

  assign image_max_width_desktop = '100%'
  assign max_width_desktop = block.settings.max_width_desktop | default: 1600 | plus: 0
  if max_width_desktop < 0 or max_width_desktop > 1600
    assign max_width_desktop = 1600
  endif
  if block.settings.limit_width_desktop and max_width_desktop > 0
    assign image_max_width_desktop = max_width_desktop | append: 'px'
  endif

  assign image_max_width_mobile = '100%'
  assign max_width_mobile = block.settings.max_width_mobile | default: 1600 | plus: 0
  if max_width_mobile < 0 or max_width_mobile > 1600
    assign max_width_mobile = 1600
  endif
  if block.settings.limit_width_mobile and max_width_mobile > 0
    assign image_max_width_mobile = max_width_mobile | append: 'px'
  endif

  unless block.settings.customize_mobile_size
    assign image_ratio_mobile = image_ratio_desktop
    assign image_height_mobile = image_height_desktop
    assign image_width_mobile = image_width_desktop
    assign image_size_mobile = image_size_desktop
    assign image_max_width_mobile = image_max_width_desktop
  endunless

  assign image_corner_radius = block.settings.corner_radius | default: 0 | plus: 0
  if image_corner_radius < 0 or image_corner_radius > 100
    assign image_corner_radius = 0
  endif

  assign padding_top = block.settings.padding_top | default: 0 | plus: 0
  assign padding_bottom = block.settings.padding_bottom | default: 0 | plus: 0
  assign padding_left = block.settings.padding_left | default: 0 | plus: 0
  assign padding_right = block.settings.padding_right | default: 0 | plus: 0
  assign padding_top_mobile = block.settings.padding_top_mobile | default: 0 | plus: 0
  assign padding_bottom_mobile = block.settings.padding_bottom_mobile | default: 0 | plus: 0
  assign padding_left_mobile = block.settings.padding_left_mobile | default: 0 | plus: 0
  assign padding_right_mobile = block.settings.padding_right_mobile | default: 0 | plus: 0

  assign image_class = 'image-block image-block--ratio-desktop-' | append: image_ratio_desktop_setting
  if block.settings.show_image_first_mobile
    assign image_class = image_class | append: ' image-block--first-mobile'
  endif
%}

{% capture image_style %}
  --image-block-width: {{ image_width_desktop }};
  --image-block-max-width: {{ image_max_width_desktop }};
  --image-block-ratio: {{ image_ratio_desktop }};
  --image-block-image-height: {{ image_height_desktop }};
  --image-block-width-mobile: {{ image_width_mobile }};
  --image-block-max-width-mobile: {{ image_max_width_mobile }};
  --image-block-ratio-mobile: {{ image_ratio_mobile }};
  --image-block-image-height-mobile: {{ image_height_mobile }};
  --image-block-padding-top: {{ padding_top }}px;
  --image-block-padding-bottom: {{ padding_bottom }}px;
  --image-block-padding-left: {{ padding_left }}px;
  --image-block-padding-right: {{ padding_right }}px;
  --image-block-padding-top-mobile: {{ padding_top_mobile }}px;
  --image-block-padding-bottom-mobile: {{ padding_bottom_mobile }}px;
  --image-block-padding-left-mobile: {{ padding_left_mobile }}px;
  --image-block-padding-right-mobile: {{ padding_right_mobile }}px;
  --image-block-radius: {{ image_corner_radius }}px;
{% endcapture %}
{% assign image_style = image_style | strip | replace: '\n', ' ' %}

<div
  class="{{ image_class }}"
  style="{{ image_style }}"
  {{ block.shopify_attributes }}
>
  {% capture image_sizes %}(min-width: 768px) {{ image_size_desktop }}, {{ image_size_mobile }}{% endcapture %}
  {% render 'image',
    image: image_source,
    mobile_image: mobile_image_source,
    url: block.settings.image_link,
    open_in_new_tab: block.settings.open_in_new_tab,
    alt: block.settings.alt_text,
    class: 'image-block__media',
    width: 2400,
    widths: '400, 600, 800, 1200, 1600, 2400',
    sizes: image_sizes
  %}
</div>

{% stylesheet %}
  .image-block {
    display: block;
    width: var(--image-block-width, fit-content);
    max-width: min(var(--image-block-max-width, 100%), 100%);
    min-width: 0;
    padding-top: var(--image-block-padding-top, 0px);
    padding-right: var(--image-block-padding-right, 0px);
    padding-bottom: var(--image-block-padding-bottom, 0px);
    padding-left: var(--image-block-padding-left, 0px);
  }

  .image-block__media {
    width: 100%;
    max-width: 100%;
    aspect-ratio: var(--image-block-ratio, auto);
    border-radius: var(--image-block-radius, 0px);
  }

  .image-block .image-block__media > picture,
  .image-block .image-block__media > img,
  .image-block .image-block__media .image__placeholder {
    display: block;
    width: 100%;
    height: var(--image-block-image-height, auto);
  }

  .image-block .image-block__media > img,
  .image-block .image-block__media > picture > img {
    object-fit: cover;
  }

  .image-block--first-mobile {
    order: -1;
  }

  @media (max-width: 767.98px) {
    .image-block {
      width: var(--image-block-width-mobile, var(--image-block-width, fit-content));
      max-width: min(var(--image-block-max-width-mobile, 100%), 100%);
      padding-top: var(--image-block-padding-top-mobile, var(--image-block-padding-top, 0px));
      padding-right: var(--image-block-padding-right-mobile, var(--image-block-padding-right, 0px));
      padding-bottom: var(--image-block-padding-bottom-mobile, var(--image-block-padding-bottom, 0px));
      padding-left: var(--image-block-padding-left-mobile, var(--image-block-padding-left, 0px));
    }

    .image-block__media {
      aspect-ratio: var(--image-block-ratio-mobile, var(--image-block-ratio, auto));
    }

    .image-block .image-block__media > picture,
    .image-block .image-block__media > img,
    .image-block .image-block__media .image__placeholder {
      height: var(--image-block-image-height-mobile, var(--image-block-image-height, auto));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.image",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:labels.mobile_image"
    },
    {
      "type": "checkbox",
      "id": "show_image_first_mobile",
      "label": "t:labels.show_image_first_mobile",
      "default": false
    },
    {
      "type": "url",
      "id": "image_link",
      "label": "t:labels.link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "t:labels.open_in_new_tab",
      "default": false
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "t:labels.alt_text"
    },
    {
      "type": "header",
      "content": "t:general.size"
    },
    {
      "type": "select",
      "id": "image_ratio_desktop",
      "label": "t:labels.desktop_image_ratio",
      "options": [
        { "value": "auto", "label": "t:options.image_ratio.auto" },
        { "value": "square", "label": "t:options.image_ratio.square" },
        { "value": "portrait", "label": "t:options.image_ratio.portrait" },
        { "value": "landscape", "label": "t:options.image_ratio.landscape" },
        { "value": "wide", "label": "t:options.image_ratio.wide" },
        { "value": "custom", "label": "t:options.image_ratio.custom" }
      ],
      "default": "auto"
    },
    {
      "type": "number",
      "id": "image_ratio_custom_width_desktop",
      "label": "W",
      "default": 16,
      "visible_if": "{{ block.settings.image_ratio_desktop == 'custom' }}"
    },
    {
      "type": "number",
      "id": "image_ratio_custom_height_desktop",
      "label": "H",
      "default": 9,
      "visible_if": "{{ block.settings.image_ratio_desktop == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_desktop",
      "label": "t:labels.desktop_width",
      "options": [
        { "value": "fit", "label": "t:options.width.fit" },
        { "value": "fill", "label": "t:options.width.fill" },
        { "value": "custom", "label": "t:options.width.custom" }
      ],
      "default": "fit"
    },
    {
      "type": "range",
      "id": "width_custom_desktop",
      "label": "t:labels.desktop_custom_width",
      "min": 1,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_desktop == 'custom' }}"
    },
    {
      "type": "checkbox",
      "id": "limit_width_desktop",
      "label": "t:labels.desktop_limit_width",
      "default": false
    },
    {
      "type": "range",
      "id": "max_width_desktop",
      "label": "t:labels.desktop_max_width",
      "min": 0,
      "max": 1600,
      "step": 16,
      "unit": "px",
      "default": 1600,
      "visible_if": "{{ block.settings.limit_width_desktop }}"
    },
    {
      "type": "checkbox",
      "id": "customize_mobile_size",
      "label": "t:labels.customize_mobile_size",
      "default": false
    },
    {
      "type": "select",
      "id": "image_ratio_mobile",
      "label": "t:labels.mobile_image_ratio",
      "options": [
        { "value": "auto", "label": "t:options.image_ratio.auto" },
        { "value": "square", "label": "t:options.image_ratio.square" },
        { "value": "portrait", "label": "t:options.image_ratio.portrait" },
        { "value": "landscape", "label": "t:options.image_ratio.landscape" },
        { "value": "wide", "label": "t:options.image_ratio.wide" },
        { "value": "custom", "label": "t:options.image_ratio.custom" }
      ],
      "default": "auto",
      "visible_if": "{{ block.settings.customize_mobile_size }}"
    },
    {
      "type": "number",
      "id": "image_ratio_custom_width_mobile",
      "label": "W",
      "default": 16,
      "visible_if": "{{ block.settings.customize_mobile_size and block.settings.image_ratio_mobile == 'custom' }}"
    },
    {
      "type": "number",
      "id": "image_ratio_custom_height_mobile",
      "label": "H",
      "default": 9,
      "visible_if": "{{ block.settings.customize_mobile_size and block.settings.image_ratio_mobile == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:labels.mobile_width",
      "options": [
        { "value": "fit", "label": "t:options.width.fit" },
        { "value": "fill", "label": "t:options.width.fill" },
        { "value": "custom", "label": "t:options.width.custom" }
      ],
      "default": "fit",
      "visible_if": "{{ block.settings.customize_mobile_size }}"
    },
    {
      "type": "range",
      "id": "width_custom_mobile",
      "label": "t:labels.mobile_custom_width",
