<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  {%- render 'foxify-head' -%}</head>

  {% assign default_color_scheme = settings.default_color_scheme %}
  {% if settings.default_color_scheme.id != blank %}
    {% assign default_color_scheme = settings.default_color_scheme.id %}
  {% endif %}
  <body class="{{ default_color_scheme | default: 'scheme-1' }}">{% sections 'foxify-header-group' %}
    {{ content_for_layout }}
  {%- render 'foxify-footer' -%}{% sections 'foxify-footer-group' %}</body>
</html>
